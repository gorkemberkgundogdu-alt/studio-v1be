---
/**
 * v1ben. — v1be'nin 3D robot maskotu. Dekoratif (aria-hidden), içerik taşımaz.
 * three.js sahnesi boşta (requestIdleCallback) dinamik import ile yüklenir:
 * LCP/CLS'e dokunmaz, JS kapalıyken sadece boş bir kare kalır (SEO hasarı yok).
 * Model tamamen kodla kurulur — GLB/ağ isteği yok (bkz src/lib/robot-mascot.ts).
 *
 * Aynı karakter sitede farklı look'larla çoğalır (bkz src/lib/robot-looks.ts):
 * `look` prop'u varyantı seçer, `name` prop'u isim plakasını ("v1ben.") basar.
 * Aynı sayfada birden çok instance güvenlidir (script tüm stage'leri kurar).
 */
interface Props {
  /** robot-looks.ts anahtarı: classic | cape | curious | reader | scout | greeter */
  look?: string;
  /** Maskotun isim plakası — marka karakteri "v1ben." */
  name?: string;
}

const { look = "classic", name } = Astro.props;
---

<div class="robot-stage" data-robot-stage data-robot-look={look} aria-hidden="true">
  <span class="robot-shadow"></span>
  <canvas class="robot-canvas"></canvas>
  {name && <span class="robot-name">{name}</span>}
</div>

<script>
  function initRobotStages() {
    const stages = document.querySelectorAll<HTMLElement>("[data-robot-stage]:not(.is-mounted)");
    if (stages.length > 0) {
      import("@/lib/robot-mascot")
        .then((m) => {
          stages.forEach((stage) => {
            stage.classList.add("is-mounted");
            m.mountRobot(stage).catch(() => {});
          });
        })
        .catch(() => {});
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRobotStages);
  } else {
    initRobotStages();
  }
  document.addEventListener("astro:page-load", initRobotStages);
</script>

<style>
  .robot-stage {
    position: relative;
    aspect-ratio: 1; /* alan SSR'da rezerve — CLS üretmez */
    width: 100%;
    pointer-events: none;
  }

  .robot-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.9s ease-out,
      transform 0.9s ease-out;
  }

  .robot-stage.is-live .robot-canvas {
    opacity: 1;
    transform: translateY(0);
  }

  .robot-shadow {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 62%;
    height: 9%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.38), transparent 70%);
    opacity: 0;
    transition: opacity 1.2s ease-out;
  }

  .robot-stage.is-live .robot-shadow {
    opacity: 1;
  }

  .robot-name {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%) translateY(6px);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--color-ink-muted);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    backdrop-filter: blur(6px);
    padding: 0.2rem 0.7rem;
    opacity: 0;
    transition:
      opacity 0.9s ease-out 0.45s,
      transform 0.9s ease-out 0.45s;
  }

  .robot-stage.is-live .robot-name {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .robot-canvas,
    .robot-name {
      transform: none;
    }

    .robot-name {
      transform: translateX(-50%);
    }
  }
</style>
