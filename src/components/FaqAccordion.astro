---
/**
 * Görünür FAQ akordeonu (details/summary — tamamen JS'siz, tüm copy HTML'de).
 * Açılış/kapanış saf CSS ile yumuşatılır (grid-template-rows 0fr↔1fr) — details
 * içeriğinin height'ı JS ile animate edilmiyor: hiçbir ek property (width dahil)
 * bu geçişten etkilenmiyor, çünkü tek dokunulan property grid satırının kendisi.
 * FAQPage JSON-LD aynı veriden AYRI olarak sayfa seviyesinde eklenir (CLAUDE.md §10).
 */
interface Props {
  title: string;
  items: readonly {
    question: string;
    answer: string;
    /** Yalnızca görünür accordion'da render olur — FAQPage şemasına sızmaz (faqSchema sadece answer okur). */
    cta?: { label: string; href: string };
  }[];
  /** Başlık seviyesi — heading hiyerarşisi asla atlamasın (CLAUDE.md §9.6). */
  level?: "h2" | "h3";
}
const { title, items, level = "h2" } = Astro.props;
const Heading = level;
---

<section aria-labelledby="faq-title">
  <Heading id="faq-title" class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</Heading>
  <div class="mt-8 divide-y divide-line border-y border-line">
    {items.map((item) => (
      <details class="faq-item group">
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-semibold text-ink transition-colors hover:text-accent"
        >
          <span>{item.question}</span>
          <svg
            aria-hidden="true"
            class="faq-chevron shrink-0 text-ink-muted transition-transform duration-200"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <div class="faq-content">
          <div class="faq-content-inner">
            <div class="faq-content-pop pb-6">
              <p class="text-sm leading-relaxed text-ink-muted sm:text-[1rem]">{item.answer}</p>
              {item.cta && (
                <a
                  href={item.cta.href}
                  class="mt-3 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-bold text-(--color-base) transition-opacity hover:opacity-90"
                >
                  {item.cta.label}
                </a>
              )}
            </div>
          </div>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-item summary::marker,
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(45deg);
    color: var(--color-accent);
  }

  /* Saf CSS soft-reveal. width/genişlik hiç bu kurallarda geçmiyor — grid satırı
     (yükseklik) dışında hiçbir box-model property'ye dokunulmuyor, bu yüzden
     satırların genişliği aç/kapa sırasında teorik olarak da değişemez. */
  .faq-item .faq-content {
    display: grid;
    grid-template-rows: 0fr;
  }
  .faq-item[open] .faq-content {
    grid-template-rows: 1fr;
  }
  .faq-content-inner {
    overflow: hidden;
    min-height: 0;
    min-width: 0;
  }

  /* "Pop" hissi — opacity/transform, compositor-only, layout'a (dolayısıyla
     genişliğe) hiç dokunmuyor. Grid satırı zaten alanı açıyor; bu katman sadece
     içeriği o alanın içinde belirginleştirip hafifçe büyüterek canlandırıyor. */
  .faq-content-pop {
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
  }
  .faq-item[open] .faq-content-pop {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item .faq-content {
      transition: grid-template-rows 280ms cubic-bezier(0.25, 0.1, 0.25, 1);
    }
    .faq-content-pop {
      transition:
        opacity 220ms ease-out,
        transform 220ms cubic-bezier(0.25, 0.1, 0.25, 1);
      transition-delay: 40ms;
    }
    .faq-item:not([open]) .faq-content-pop {
      transition-delay: 0ms;
    }
  }
</style>
