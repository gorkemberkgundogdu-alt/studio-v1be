---
import { SITE } from "@/config/site";

type Props = {
  image: string;
  alt: string;
  route?: string;
  status?: string;
  priority?: boolean;
};

const { image, alt, route = "/", status, priority = false } = Astro.props;
const dots = ["bg-[#ff5f57]", "bg-[#febc2e]", "bg-[#28c840]"];
const address = `${new URL(SITE.parentOrg.url).hostname}${route}`;
---

<div class="overflow-hidden rounded-[1.5rem] border border-white/15 bg-[#201246] shadow-[0_28px_90px_rgba(0,0,0,0.3)] md:rounded-[2rem]">
  <div class="flex h-11 items-center gap-2 border-b border-white/10 bg-[#171719] px-4">
    {dots.map((dot) => <span class:list={["size-2.5 rounded-full", dot]}></span>)}
    <span class="ml-3 min-w-0 flex-1 truncate rounded-full border border-white/10 bg-white/[0.04] px-4 py-1.5 text-center font-mono text-[0.58rem] text-white/55 sm:text-[0.65rem]">
      {address}
    </span>
    {status && <span class="font-mono text-[0.58rem] font-bold uppercase tracking-wider text-accent">{status}</span>}
  </div>
  <img
    src={image}
    {alt}
    width="1265"
    height="712"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    class="block h-auto w-full"
  />
</div>
