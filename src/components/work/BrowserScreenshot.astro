---
import { SITE } from "@/config/site";

type Props = {
  image?: string;
  alt?: string;
  route?: string;
  domain?: string;
  status?: string;
  priority?: boolean;
  placeholderLabel?: string;
  theme?: "dark" | "light";
};

const {
  image,
  alt = "",
  route = "/",
  domain,
  status,
  priority = false,
  placeholderLabel = "Production asset placeholder",
  theme = "dark",
} = Astro.props;

const dots = ["bg-[#ff5f57]", "bg-[#febc2e]", "bg-[#28c840]"];
const resolvedDomain = domain || new URL(SITE.parentOrg.url).hostname;
const address = `${resolvedDomain}${route}`;
const isLight = theme === "light";
---

<div
  class:list={[
    "overflow-hidden rounded-[1.5rem] border shadow-[0_28px_90px_rgba(0,0,0,0.25)] md:rounded-[2rem]",
    isLight
      ? "border-light-line bg-white/70"
      : "border-white/15 bg-[#18181b]",
  ]}
>
  <div
    class:list={[
      "flex h-11 items-center gap-2 border-b px-4",
      isLight
        ? "border-light-line bg-[#f4f0e6]"
        : "border-white/10 bg-[#141416]",
    ]}
  >
    <div class="flex items-center gap-1.5" aria-hidden="true">
      {dots.map((dot) => <span class:list={["size-2.5 rounded-full", dot]}></span>)}
    </div>
    <span
      class:list={[
        "ml-3 min-w-0 flex-1 truncate rounded-full border px-4 py-1.5 text-center font-mono text-[0.58rem] sm:text-[0.65rem]",
        isLight
          ? "border-light-line bg-white/60 text-light-muted"
          : "border-white/10 bg-white/[0.04] text-white/55",
      ]}
    >
      {address}
    </span>
    {status && (
      <span
        class:list={[
          "font-mono text-[0.58rem] font-bold uppercase tracking-wider",
          isLight ? "text-green" : "text-accent",
        ]}
      >
        {status}
      </span>
    )}
  </div>

  {image ? (
    <img
      src={image}
      {alt}
      width="1265"
      height="712"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      class="block h-auto w-full"
    />
  ) : Astro.slots.has("default") ? (
    <div class="relative w-full overflow-hidden">
      <slot />
    </div>
  ) : (
    <div
      class:list={[
        "relative flex aspect-[16/9.5] w-full flex-col items-center justify-center p-6 text-center sm:p-10",
        isLight
          ? "bg-gradient-to-b from-white/60 to-white/90 text-light-ink"
          : "grid-texture bg-gradient-to-b from-[#161619] to-[#0e0e10] text-white",
      ]}
      role="img"
      aria-label={`${alt || placeholderLabel} (${address})`}
    >
      <div
        class:list={[
          "relative flex max-w-md flex-col items-center rounded-2xl border border-dashed p-6 sm:p-8",
          isLight
            ? "border-light-line bg-white/70 shadow-sm"
            : "border-line bg-surface/50 shadow-sm",
        ]}
      >
        <div
          class:list={[
            "inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-[0.62rem] font-bold uppercase tracking-[0.14em]",
            isLight
              ? "border-green/30 bg-green/10 text-green"
              : "border-accent/30 bg-accent/10 text-accent",
          ]}
        >
          <span class="size-1.5 rounded-full animate-pulse bg-current"></span>
          {placeholderLabel}
        </div>
        <p
          class:list={[
            "mt-3 text-sm font-semibold sm:text-base",
            isLight ? "text-light-ink" : "text-white",
          ]}
        >
          {alt || "v1be studio live production system"}
        </p>
        <p
          class:list={[
            "mt-1 font-mono text-xs opacity-75",
            isLight ? "text-light-muted" : "text-white/60",
          ]}
        >
          Target: {address}
        </p>
      </div>
    </div>
  )}
</div>
