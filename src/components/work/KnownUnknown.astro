---
interface Props { knownLabel: string; unknownLabel: string; known: readonly string[]; unknown: readonly string[]; closing: string; }
const { knownLabel, unknownLabel, known, unknown, closing } = Astro.props;
---
<div class="mt-10 grid gap-3 lg:grid-cols-[1.2fr_0.8fr]" data-reveal-group>
  <section class="rounded-3xl border border-line bg-surface/45 p-6 sm:p-8" data-reveal>
    <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{knownLabel}</p>
    <ul class="mt-6 space-y-4">{known.map((item) => <li class="flex gap-3 text-sm leading-relaxed text-ink"><span class="text-accent" aria-hidden="true">✓</span><span>{item}</span></li>)}</ul>
  </section>
  <section class="rounded-3xl border border-accent/45 bg-accent/[0.06] p-6 sm:p-8" data-reveal>
    <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{unknownLabel}</p>
    <ul class="mt-6 space-y-4">{unknown.map((item) => <li class="text-sm leading-relaxed text-ink-muted">{item}</li>)}</ul>
  </section>
</div>
<p class="mt-6 border-l-2 border-accent pl-4 text-sm font-bold leading-relaxed text-ink">{closing}</p>
