---
interface Props {
  term: string;
  abbreviation: string;
  definition: string;
}

const { term, abbreviation, definition } = Astro.props;
---

<details class="geo-glossary inline align-baseline">
  <summary
    class="inline cursor-pointer font-inherit text-inherit underline decoration-accent/70 decoration-dotted underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
    aria-label={`Definition of ${term} (${abbreviation})`}
  >
    <dfn class="not-italic font-bold text-accent"><abbr title={term}>{term} ({abbreviation})</abbr></dfn>
  </summary>
  <span
    class="geo-glossary-definition mt-2 block max-w-sm rounded-xl border border-accent/40 bg-surface/95 p-4 text-xs font-normal leading-relaxed text-ink shadow-2xl backdrop-blur-md sm:absolute sm:left-0 sm:top-full sm:z-30"
    role="tooltip"
  >
    <strong class="block font-mono text-[0.62rem] font-bold uppercase tracking-wider text-accent mb-1">
      {abbreviation} · Term Definition
    </strong>
    {definition}
  </span>
</details>

<style>
  .geo-glossary {
    position: relative;
    display: inline-block;
  }
  .geo-glossary summary::-webkit-details-marker,
  .geo-glossary summary::marker {
    display: none;
    content: "";
  }
  @media (hover: hover) and (pointer: fine) {
    .geo-glossary:not([open]):hover .geo-glossary-definition,
    .geo-glossary:not([open]):focus-within .geo-glossary-definition {
      display: block;
    }
    .geo-glossary:not([open]) .geo-glossary-definition {
      display: none;
    }
  }
</style>
