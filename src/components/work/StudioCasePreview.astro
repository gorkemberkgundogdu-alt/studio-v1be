---
type Props = {
  preview: {
    label: string;
    english: string;
    turkish: string;
    schema: string;
    crawler: string;
  };
};

const { preview } = Astro.props;
---

<div class="relative min-h-56 overflow-hidden rounded-2xl border border-line bg-base p-4 text-ink">
  <div class="pointer-events-none absolute inset-0 opacity-70 [background-image:linear-gradient(to_right,rgba(255,248,232,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,248,232,0.06)_1px,transparent_1px)] [background-size:32px_32px]"></div>
  <div class="relative flex items-center justify-between border-b border-line pb-3 font-mono text-[0.58rem] font-bold uppercase tracking-[0.16em]">
    <span>{preview.label}</span>
    <span class="text-accent">/</span>
  </div>

  <div class="relative mt-4 space-y-3">
    <div class="rounded-xl border border-line bg-surface/75 p-3">
      <div class="flex items-center justify-between gap-3"><span class="font-mono text-xs font-bold text-accent">/</span><span class="text-xs font-bold text-ink-muted">{preview.english}</span></div>
      <div class="mt-2 h-1.5 w-4/5 rounded-full bg-ink"></div>
    </div>
    <div class="rounded-xl border border-accent/35 bg-accent/[0.08] p-3">
      <div class="flex items-center justify-between gap-3"><span class="font-mono text-xs font-bold text-accent">/tr/</span><span class="text-xs font-bold text-ink-muted">{preview.turkish}</span></div>
      <div class="mt-2 h-1.5 w-3/5 rounded-full bg-accent"></div>
    </div>
  </div>

  <div class="relative mt-4 grid grid-cols-2 gap-2">
    <div class="rounded-lg border border-line bg-surface/70 p-2.5"><p class="font-mono text-[0.55rem] uppercase tracking-[0.12em] text-ink-muted">{preview.schema}</p><p class="mt-1 text-xs font-bold text-accent">inLanguage</p></div>
    <div class="rounded-lg border border-line bg-surface/70 p-2.5"><p class="font-mono text-[0.55rem] uppercase tracking-[0.12em] text-ink-muted">{preview.crawler}</p><p class="mt-1 text-xs font-bold text-accent">HTML</p></div>
  </div>
</div>
