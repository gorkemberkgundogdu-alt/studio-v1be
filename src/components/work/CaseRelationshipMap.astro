---
interface Props {
  nodes: readonly string[];
  eyebrow?: string;
}

const {
  nodes,
  eyebrow = "Lineage · v1be.io → v1be studio",
} = Astro.props;

const nodeRoles = [
  "Origin",
  "Learnings",
  "System",
  "Service Arm",
];
---

<figure
  class="overflow-hidden rounded-2xl border border-line bg-surface/50 p-4 sm:p-5"
  data-reveal
>
  <figcaption class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-3 font-mono text-[0.62rem] font-bold uppercase tracking-[0.14em]">
    <span class="text-accent" style="color: var(--color-accent, #d1f300);">{eyebrow}</span>
    <span class="text-white/60">Shared DNA · Distinct Jobs</span>
  </figcaption>

  <ol
    class="mt-3.5 grid gap-2 sm:grid-cols-2 lg:grid-cols-4"
    aria-label="The relationship between v1be.io and v1be studio"
  >
    {nodes.map((node, index) => {
      const isStart = index === 0;
      const isEnd = index === nodes.length - 1;
      const role = nodeRoles[index] || `0${index + 1}`;
      return (
        <li
          class:list={[
            "relative flex flex-col justify-center rounded-xl border p-3 sm:p-3.5 transition-all",
            isStart && "border-white/20 bg-base/90 shadow-sm",
            isEnd && "border-accent bg-accent/[0.08] shadow-[0_0_20px_rgba(209,243,0,0.06)]",
            !isStart && !isEnd && "border-line/70 bg-base/50",
          ]}
        >
          <div class="flex items-center justify-between gap-1.5">
            <span
              class="font-mono text-[0.68rem] font-bold uppercase tracking-wider"
              style={isEnd ? "color: var(--color-accent, #d1f300);" : "color: rgba(255, 255, 255, 0.65);"}
            >
              0{index + 1}
            </span>
            <span
              class:list={[
                "whitespace-nowrap rounded-full px-2 py-0.5 font-mono text-[0.52rem] font-bold uppercase tracking-wider",
                isStart && "border border-white/20 bg-white/5 text-white/80",
                isEnd && "border border-accent/50 bg-accent/15 text-accent",
                !isStart && !isEnd && "border border-white/10 bg-white/[0.03] text-white/60",
              ]}
              style={isEnd ? "color: var(--color-accent, #d1f300);" : ""}
            >
              {role}
            </span>
          </div>

          <p
            class="mt-2 text-xs sm:text-sm font-extrabold leading-snug"
            style={isEnd ? "color: var(--color-accent, #d1f300);" : "color: #ffffff;"}
          >
            {node}
          </p>

          {index < nodes.length - 1 && (
            <div
              class="hidden font-mono text-xs text-accent/50 lg:absolute lg:-right-2 lg:top-1/2 lg:-translate-y-1/2 lg:z-10 lg:block"
              style="color: var(--color-accent, #d1f300);"
              aria-hidden="true"
            >
              →
            </div>
          )}
        </li>
      );
    })}
  </ol>
</figure>
