---
import RobotMascot from "@/components/sections/RobotMascot.astro";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const isTr = locale === "tr";
---

<div class="relative min-h-[460px] sm:min-h-[520px] w-full overflow-hidden bg-[#121214] grid-texture p-4 sm:p-8 flex flex-col justify-between select-none">
  {/* Mini simulated top navigation */}
  <div class="flex items-center justify-between border-b border-white/10 pb-4">
    <div class="flex items-center gap-2">
      <span class="font-bold tracking-tight text-sm sm:text-base text-white">
        v1be <span style="color: var(--color-accent, #d1f300);">studio</span>
      </span>
      <span class="text-white/40 text-xs font-mono hidden sm:inline">| {isTr ? "web tasarım & geliştirme" : "web design & development"}</span>
    </div>
    <div class="flex items-center gap-3">
      <span class="hidden sm:inline-block rounded-full border border-white/15 px-3 py-1 font-mono text-[0.62rem] text-white/70">
        {isTr ? "TR ▾" : "EN ▾"}
      </span>
      <span
        class="rounded-full px-3.5 py-1 text-[0.68rem] font-bold text-[#121214]"
        style="background-color: var(--color-accent, #d1f300);"
      >
        {isTr ? "Ücretsiz denetim al" : "Get a free audit"}
      </span>
      <span class="text-xs font-mono text-white/70">{isTr ? "Menü" : "Menu"}</span>
    </div>
  </div>

  {/* Hero centered content */}
  <div class="relative my-auto py-6 sm:py-8 text-center">
    <h2
      class="font-extrabold text-white tracking-tight leading-[1.04]"
      style="font-size: clamp(1.85rem, 1.25rem + 3.5vw, 3.85rem);"
    >
      {isTr ? (
        <>
          Awwwards için <span class="text-white">estetik.</span><br />
          Yapay zekâ için <span style="color: var(--color-accent, #d1f300);">yapılandırılmış.</span>
        </>
      ) : (
        <>
          Beautiful enough<br />
          for <span class="text-white">Awwwards.</span><br />
          Structured enough<br />
          for <span style="color: var(--color-accent, #d1f300);">AI.</span>
        </>
      )}
    </h2>

    {/* Central Robot Mascot */}
    <div class="relative mx-auto mt-4 w-[160px] sm:w-[200px] lg:w-[230px] shrink-0">
      <RobotMascot look="classic" name="v1ben." />
    </div>

    {/* Floating card from Image 2 */}
    <div class="hidden md:block absolute right-2 bottom-4 max-w-[250px] rounded-2xl border border-white/15 bg-[#18181b]/95 p-4 text-left shadow-2xl backdrop-blur z-10">
      <div class="flex items-center justify-between">
        <span class="font-mono text-[0.58rem] font-bold uppercase tracking-wider" style="color: var(--color-accent, #d1f300);">
          {isTr ? "V1BE'DEN" : "FROM V1BE"}
        </span>
        <span class="text-white/40 text-xs">×</span>
      </div>
      <p class="mt-2 text-xs font-bold text-white leading-snug">
        {isTr ? "Görünürlüğü bir büyüme sistemine dönüştürün." : "Turn visibility into a growth system."}
      </p>
      <p class="mt-1 text-[0.68rem] text-white/70 leading-relaxed">
        {isTr ? "v1be; içerik, marka içgörüsü ve AI otomasyonunu insan onaylı tek platformda buluşturur." : "v1be connects content, brand intelligence and AI automation in one human-approved platform."}
      </p>
      <div
        class="mt-3 inline-flex items-center gap-1 rounded-full px-3 py-1 text-[0.65rem] font-bold text-[#121214]"
        style="background-color: var(--color-accent, #d1f300);"
      >
        {isTr ? "v1be'yi keşfedin →" : "Explore v1be →"}
      </div>
    </div>
  </div>

  {/* Bottom scroll hint */}
  <div class="pt-2 text-center">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-[0.62rem] text-white/70">
      ↓ {isTr ? "Kaydırmaya devam edin" : "Keep scrolling"}
    </span>
  </div>
</div>
