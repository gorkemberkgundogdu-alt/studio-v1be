---
type ProofSignal = {
  label: string;
  value: string;
};

type Props = {
  proof: readonly ProofSignal[];
  copy: {
    stackLabel: string;
    caseLabel: string;
    schemaGraph: string;
    organization: string;
    website: string;
    validation: string;
    validationText: string;
  };
};

const { proof, copy } = Astro.props;
---

<div
  class="relative min-h-[22rem] overflow-hidden rounded-[1.75rem] border border-white/15 bg-base p-5 text-ink shadow-[0_28px_80px_rgba(18,18,20,0.28)] sm:p-6"
  data-work-proof
>
  <div class="pointer-events-none absolute inset-0 opacity-70 [background-image:linear-gradient(to_right,rgba(255,248,232,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,248,232,0.06)_1px,transparent_1px)] [background-size:40px_40px]"></div>

  <div class="relative flex items-center justify-between border-b border-line pb-4 font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em]">
    <span>{copy.stackLabel}</span>
    <span class="text-accent">{copy.caseLabel}</span>
  </div>

  <div class="relative mt-5 grid gap-3 sm:grid-cols-[1.15fr_0.85fr]">
    <div class="rounded-2xl border border-line bg-surface/80 p-4">
      <div class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-ink-muted"></span>
        <span class="size-1.5 rounded-full bg-ink-muted"></span>
        <span class="size-1.5 rounded-full bg-accent"></span>
      </div>

      <div class="mt-8 space-y-3">
        <span class="block h-2 w-16 rounded-full bg-accent"></span>
        <span class="block h-3 w-4/5 rounded-full bg-ink"></span>
        <span class="block h-3 w-3/5 rounded-full bg-ink"></span>
        <span class="block h-2 w-full rounded-full bg-ink-muted/45"></span>
        <span class="block h-2 w-4/5 rounded-full bg-ink-muted/45"></span>
      </div>

      <div class="mt-8 grid grid-cols-3 gap-2">
        <span class="h-14 rounded-lg border border-line bg-base/70"></span>
        <span class="h-14 rounded-lg border border-line bg-base/70"></span>
        <span class="h-14 rounded-lg border border-accent/45 bg-accent/10"></span>
      </div>
    </div>

    <div class="space-y-3">
      <div class="rounded-2xl border border-line bg-surface/80 p-4">
        <p class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.16em] text-ink-muted">{copy.schemaGraph}</p>
        <div class="mt-4 flex items-center justify-between gap-2">
          <span class="rounded-full border border-line px-2 py-1 font-mono text-[0.58rem]">{copy.organization}</span>
          <span class="h-px flex-1 bg-accent/60"></span>
          <span class="size-2 rounded-full bg-accent"></span>
        </div>
        <div class="mt-3 flex items-center justify-between gap-2">
          <span class="rounded-full border border-line px-2 py-1 font-mono text-[0.58rem]">{copy.website}</span>
          <span class="h-px flex-1 bg-accent/60"></span>
          <span class="size-2 rounded-full bg-accent"></span>
        </div>
      </div>

      <div class="rounded-2xl border border-accent/40 bg-accent/10 p-4">
        <p class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.16em] text-accent">{copy.validation}</p>
        <p class="mt-2 text-sm font-bold text-ink">{copy.validationText}</p>
      </div>
    </div>
  </div>

  <dl class="relative mt-3 grid gap-2 sm:grid-cols-3">
    {proof.map((item) => (
      <div class="rounded-xl border border-line bg-base/85 p-3">
        <dt class="text-[0.68rem] leading-tight text-ink-muted">{item.label}</dt>
        <dd class="mt-1 text-sm font-extrabold text-accent">{item.value}</dd>
      </div>
    ))}
  </dl>
</div>
