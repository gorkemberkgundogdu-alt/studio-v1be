---
interface Props {
  steps: readonly string[];
}

const { steps } = Astro.props;

const stepDescriptions: Record<string, string> = {
  DESIGN: "Brand character, fluid typography, and layout.",
  CODE: "Static-first Astro architecture and type safety.",
  "SEO/GEO": "Semantic schema graph and AI discovery rules.",
  DEPLOY: "Deterministic static build and edge distribution.",
  OBSERVE: "Real-world traffic, AI crawlers, and intent.",
  IMPROVE: "Empirical findings fed directly back to design.",
};
---

<div class="mt-8 overflow-hidden rounded-[1.75rem] border border-line bg-surface/50 p-5 sm:p-6" data-reveal>
  <div class="flex items-center justify-between border-b border-line pb-3 font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em]">
    <span class="text-accent">Empirical Cycle · 6 Iteration Stages</span>
    <span class="text-ink-muted">Continuous Feedback Loop</span>
  </div>

  <ol
    class="methodology-loop mt-4 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3"
    aria-label="Continuous improvement methodology"
    data-reveal-group
  >
    {steps.map((step, index) => {
      const isLast = index === steps.length - 1;
      const desc = stepDescriptions[step] || "Continuous iteration stage.";
      return (
        <li
          class:list={[
            "relative flex flex-col justify-between rounded-xl border p-3.5 sm:p-4 transition-colors",
            isLast
              ? "border-accent/60 bg-accent/[0.08]"
              : "border-line bg-base/70",
          ]}
          data-reveal
          style={`--reveal-delay: ${index * 45}ms`}
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[0.68rem] font-bold text-accent">
                0{index + 1}
              </span>
              {isLast && (
                <span class="rounded-full border border-accent/40 bg-accent/20 px-2 py-0.5 font-mono text-[0.52rem] font-bold uppercase tracking-wider text-accent">
                  Feedback Loop
                </span>
              )}
            </div>
            <h3 class="mt-2 font-mono text-sm font-bold uppercase tracking-[0.12em] text-ink">
              {step}
            </h3>
            <p class="mt-1 text-[0.78rem] leading-snug text-ink-muted">
              {desc}
            </p>
          </div>

          <div class="mt-3 pt-2 border-t border-line/40">
            {isLast ? (
              <span class="inline-flex items-center gap-1 font-mono text-[0.68rem] font-bold text-accent">
                <span>↺</span> Feed back to Design
              </span>
            ) : (
              <span class="font-mono text-[0.62rem] text-ink-muted/80">
                0{index + 1} → 0{index + 2}
              </span>
            )}
          </div>
        </li>
      );
    })}
  </ol>
</div>
