---
/**
 * Ücretsiz audit talep formu (CLAUDE.md §5 S5). Alanlar: name, email, website, message.
 * FORM_ENDPOINT (Formspree-tarzı) varsa native POST eder — JS kapalıyken de çalışır.
 * Endpoint yoksa JS submit'i mailto'ya çevirir; her hâlükârda görünür bir doğrudan
 * email linki fallback olarak durur (graceful degradation, CLAUDE.md §12.3).
 */
import { useTranslations, type Locale } from "@/i18n";
import { SITE, FORM_ENDPOINT } from "@/config/site";
import Button from "@/components/ui/Button.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const f = t.contact.form;
const hasEndpoint = FORM_ENDPOINT.length > 0;
const projectContextMap = {
  paths: Object.fromEntries(t.packages.paths.map((path) => [path.id, path.title])),
  needs: Object.fromEntries(t.packages.configurator.needs.map((need) => [need.id, need.briefLabel])),
};
---

<form
  class="audit-form flex flex-col gap-4"
  data-audit-form
  data-endpoint={hasEndpoint ? FORM_ENDPOINT : undefined}
  data-email={SITE.email}
  data-project-context-map={JSON.stringify(projectContextMap)}
  action={hasEndpoint ? FORM_ENDPOINT : `mailto:${SITE.email}`}
  method="POST"
  enctype={hasEndpoint ? undefined : "text/plain"}
>
  <div
    class="hidden rounded-xl border border-accent/30 bg-accent/10 px-4 py-3 text-sm text-ink"
    data-project-context
    role="status"
  >
    <span class="font-mono text-xs font-bold uppercase tracking-wider text-accent">Project brief attached</span>
    <span class="mt-1 block text-ink-muted" data-project-context-copy></span>
  </div>

  <input type="hidden" name="project_path" value="" data-project-path />
  <input type="hidden" name="project_needs" value="" data-project-needs />

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-ink">{f.nameLabel}</span>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        placeholder={f.namePlaceholder}
        class="h-11 rounded-xl border border-line bg-base px-3.5 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
      />
    </label>
    <label class="flex flex-col gap-1.5 text-sm">
      <span class="font-medium text-ink">{f.emailLabel}</span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder={f.emailPlaceholder}
        class="h-11 rounded-xl border border-line bg-base px-3.5 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
      />
    </label>
  </div>

  <label class="flex flex-col gap-1.5 text-sm">
    <span class="font-medium text-ink">{f.websiteLabel}</span>
    <input
      type="url"
      name="website"
      required
      inputmode="url"
      autocomplete="url"
      placeholder={f.websitePlaceholder}
      class="h-11 rounded-xl border border-line bg-base px-3.5 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
    />
  </label>

  <label class="flex flex-col gap-1.5 text-sm">
    <span class="font-medium text-ink">{f.messageLabel}</span>
    <textarea
      name="message"
      rows="4"
      placeholder={f.messagePlaceholder}
      class="rounded-xl border border-line bg-base px-3.5 py-3 text-ink placeholder:text-ink-muted/60 focus:border-accent focus:outline-none"
    ></textarea>
  </label>

  <p class="form-error hidden text-sm text-accent" data-form-error role="alert"></p>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <Button type="submit" class="w-full sm:w-auto">
      <span data-submit-label>{f.submit}</span>
    </Button>
    <p class="text-xs text-ink-muted">{f.reassurance}</p>
  </div>

  <p class="mt-1 text-sm text-ink-muted">
    {f.mailtoIntro}{" "}
    <a
      href={`mailto:${SITE.email}`}
      class="font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-accent"
    >
      {SITE.email}
    </a>
  </p>
</form>

<div
  class="form-success hidden rounded-2xl border border-line bg-surface p-6"
  data-form-success
  role="status"
  aria-live="polite"
>
  <p class="text-lg font-semibold text-ink">{f.successTitle}</p>
  <p class="mt-2 text-sm leading-relaxed text-ink-muted">{f.successBody}</p>
</div>

<script>
  import { track, trackLead } from "@/lib/analytics";

  // Progressive enhancement (CLAUDE.md §12.3). Endpoint varsa fetch ile inline
  // success; yoksa mailto oluşturur. JS yoksa: native POST (endpoint) veya
  // görünür email linki fallback.
  const form = document.querySelector<HTMLFormElement>("[data-audit-form]");
  if (form) {
    const endpoint = form.dataset.endpoint;
    const email = form.dataset.email ?? "";
    const errorEl = form.querySelector<HTMLElement>("[data-form-error]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const successEl = document.querySelector<HTMLElement>("[data-form-success]");
    const labelDefault = submitLabel?.textContent ?? "";
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
    const projectPathInput = form.querySelector<HTMLInputElement>("[data-project-path]");
    const projectNeedsInput = form.querySelector<HTMLInputElement>("[data-project-needs]");
    const projectContext = form.querySelector<HTMLElement>("[data-project-context]");
    const projectContextCopy = form.querySelector<HTMLElement>("[data-project-context-copy]");

    const params = new URLSearchParams(window.location.search);
    const selectedPath = params.get("path") ?? "";
    const selectedNeeds = params.getAll("needs");
    const sourceParam = params.get("source") ?? "";
    const allowedSources = new Set(["packages-hero", "packages-proof", "packages-footer"]);
    const formSource = selectedPath
      ? "packages_brief"
      : allowedSources.has(sourceParam) ? sourceParam : "contact";
    const isPackagesLead = selectedPath.length > 0 || formSource.startsWith("packages");
    const projectContextMap = JSON.parse(form.dataset.projectContextMap ?? '{"paths":{},"needs":{}}') as {
      paths: Record<string, string>;
      needs: Record<string, string>;
    };
    const pathLabels = projectContextMap.paths;
    const needLabels = projectContextMap.needs;

    if (selectedPath || selectedNeeds.length > 0) {
      if (projectPathInput) projectPathInput.value = pathLabels[selectedPath] ?? selectedPath;
      if (projectNeedsInput) {
        projectNeedsInput.value = selectedNeeds.map((need) => needLabels[need] ?? need).join(", ");
      }
      if (projectContextCopy) {
        projectContextCopy.textContent = [
          pathLabels[selectedPath] ?? selectedPath,
          selectedNeeds.map((need) => needLabels[need] ?? need).join(" · "),
        ].filter(Boolean).join(" — ");
      }
      projectContext?.classList.remove("hidden");
    }

    const showError = (msg: string) => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove("hidden");
    };
    const clearError = () => errorEl?.classList.add("hidden");

    const isValidEmail = (v: string) => /.+@.+\..+/.test(v);
    let submitting = false;

    form.addEventListener("input", () => {
      track("form_start", {
        form_id: "free_audit",
        form_source: formSource,
        brief_attached: selectedPath.length > 0 || selectedNeeds.length > 0,
      });
    }, { once: true });

    const getData = () => {
      const fd = new FormData(form);
      return {
        name: String(fd.get("name") ?? ""),
        email: String(fd.get("email") ?? ""),
        website: String(fd.get("website") ?? ""),
        message: String(fd.get("message") ?? ""),
        projectPath: String(fd.get("project_path") ?? ""),
        projectNeeds: String(fd.get("project_needs") ?? ""),
        fd,
      };
    };

    form.addEventListener("submit", async (e) => {
      clearError();
      const { name, email: em, website, message, projectPath, projectNeeds, fd } = getData();

      if (!name || !em || !website) {
        // Native required zaten yakalar; JS tarafında da nazik kontrol.
        return;
      }
      if (!isValidEmail(em)) {
        e.preventDefault();
        emailInput?.focus();
        showError(form.dataset.invalidEmail ?? "Please enter a valid email address.");
        return;
      }

      if (!endpoint) {
        // mailto fallback
        e.preventDefault();
        const subject = encodeURIComponent(`Free audit request — ${website}`);
        const body = encodeURIComponent(
          `Name: ${name}\nEmail: ${em}\nWebsite: ${website}\nPath: ${projectPath || "Not selected"}\nPriorities: ${projectNeeds || "Not selected"}\n\n${message}`,
        );
        track("audit_form_submit", {
          form_id: "free_audit",
          form_source: formSource,
          delivery_method: "mailto",
          brief_attached: selectedPath.length > 0 || selectedNeeds.length > 0,
        });
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        return;
      }

      // Formspree-tarzı: fetch ile gönder, sayfada kal, inline success göster.
      e.preventDefault();
      if (submitting) return;
      submitting = true;
      submitButton?.setAttribute("disabled", "");
      submitButton?.setAttribute("aria-busy", "true");
      if (submitLabel) submitLabel.textContent = "Sending…";
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          body: fd,
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        track("audit_form_submit", {
          form_id: "free_audit",
          form_source: formSource,
          delivery_method: "form_endpoint",
          brief_attached: selectedPath.length > 0 || selectedNeeds.length > 0,
        });
        trackLead({
          lead_type: "contact_form",
          lead_source: isPackagesLead ? "pricing" : "contact",
          goal: "free_audit",
          user_data: { email: em, name, brand: website },
        });
        form.classList.add("hidden");
        successEl?.classList.remove("hidden");
        successEl?.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch {
        submitting = false;
        submitButton?.removeAttribute("disabled");
        submitButton?.removeAttribute("aria-busy");
        if (submitLabel) submitLabel.textContent = labelDefault;
        showError(
          `Something went wrong. Please email us directly at ${email}.`,
        );
      }
    });
  }
</script>
