---
/**
 * Görünür breadcrumb — BreadcrumbList JSON-LD ile aynı veriden (CLAUDE.md §9.1).
 * Son öğe aktif sayfadır (link değil).
 */
import { localizePath, useTranslations, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  items: readonly { name: string; path: string }[];
}
const { locale, items } = Astro.props;
const t = useTranslations(locale);
---

<nav aria-label={t.a11y.breadcrumb} class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
  <ol class="flex flex-wrap items-center gap-2 text-xs text-ink-muted">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i < items.length - 1 ? (
          <a href={localizePath(locale, item.path)} class="transition-colors hover:text-ink">
            {item.name}
          </a>
        ) : (
          <span class="text-ink" aria-current="page">{item.name}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-line">/</span>}
      </li>
    ))}
  </ol>
</nav>
