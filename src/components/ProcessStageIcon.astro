---
import type { ProcessStageId } from "@/types/process";

interface Props {
  kind: ProcessStageId;
  class?: string;
}

const { kind, class: className } = Astro.props;
---

<svg
  class:list={["size-4", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {kind === "diagnose" && (
    <>
      <circle cx="12" cy="12" r="2.25" />
      <path d="M5.9 9.3a6.7 6.7 0 0 0 0 5.4M18.1 9.3a6.7 6.7 0 0 1 0 5.4" />
      <path d="M3.2 6.5a10.6 10.6 0 0 0 0 11M20.8 6.5a10.6 10.6 0 0 1 0 11" />
    </>
  )}
  {kind === "design" && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <path d="M8 4v16M8 9h13M12 13h5M12 16h3" />
    </>
  )}
  {kind === "build" && (
    <>
      <path d="m8 7-4 5 4 5M16 7l4 5-4 5M14 4l-4 16" />
      <path d="M10.5 7h3M10.5 17h3" />
    </>
  )}
  {kind === "validate" && (
    <>
      <path d="M4 19V5M4 19h16" />
      <path d="m7 15 3-3 2.5 2 4.5-6" />
      <path d="m15.5 8 1.5-.2.2 1.6" />
    </>
  )}
</svg>
