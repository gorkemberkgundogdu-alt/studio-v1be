---
/**
 * Üç varyant: primary (accent), surface (koyu dolgu) ve ghost (çerçeve). CLAUDE.md §3, §11.3.
 * href verilirse <a>, verilmezse <button>. .cta-lift micro-interaction taşır.
 */
type DataAttributes = {
  [key: `data-${string}`]: string | number | boolean | undefined;
};

type AriaAttributes = {
  [key: `aria-${string}`]: string | number | boolean | undefined;
};

type Props = {
  href?: string;
  variant?: "primary" | "ghost" | "surface";
  size?: "sm" | "md";
  type?: "button" | "submit";
  class?: string;
} & DataAttributes & AriaAttributes;

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className,
  ...attributes
} = Astro.props;

const classes = [
  "cta-lift inline-flex items-center justify-center rounded-full font-bold",
  "transition-colors duration-300",
  size === "sm" ? "h-9 px-4 text-sm" : "h-12 px-7 text-base",
  variant === "primary"
    ? "bg-accent text-(--color-base) hover:bg-accent-hot"
    : variant === "surface"
      ? "bg-surface text-accent hover:bg-purple"
    : "border border-line text-ink hover:border-ink-muted hover:text-ink",
  className,
];

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={classes}
  style={variant === "surface" ? "color: var(--color-accent)" : undefined}
  {...attributes}
>
  <slot />
</Tag>
