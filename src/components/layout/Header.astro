---
/**
 * Site header'ı (CLAUDE.md §4). Logo sol; sağda CTA "Get a free audit" +
 * "Menu" tetikleyicisi, tüm breakpoint'lerde aynı (ayrı bir desktop inline
 * nav yok artık — nav linkleri tam ekran overlay'e taşındı).
 *
 * Overlay: JS ile açılır (opacity/transform toggle, display:none KULLANILMAZ)
 * — nav linkleri SSR HTML'de her zaman mevcut ve view-source'ta okunur
 * (GEO/SEO gereksinimi), JS kapalıyken görsel olarak açılamaz ama içerik
 * crawler'lar için her zaman erişilebilir kalır.
 */
import { useTranslations, localizePath, type Locale } from "@/i18n";
import Button from "@/components/ui/Button.astro";
import { SITE } from "@/config/site";

interface Props {
  locale: Locale;
  path: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { href: localizePath(locale, "/packages/"), label: t.nav.packages },
  { href: localizePath(locale, "/process/"), label: t.nav.process },
  { href: localizePath(locale, "/work/"), label: t.nav.work },
  { href: localizePath(locale, "/about/"), label: t.nav.about },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-base/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a
      href={localizePath(locale, "/")}
      class="min-w-0 shrink text-lg font-bold tracking-tight"
      aria-label="v1be studio — home"
    >
      v1be<span class="text-accent"> studio</span><span class="hidden font-medium text-ink-muted md:inline"> | web design &amp; development</span>
    </a>

    <div class="flex shrink-0 items-center gap-4">
      <Button href={localizePath(locale, "/contact/")} size="sm">{t.nav.cta}</Button>

      <button
        type="button"
        id="nav-menu-trigger"
        class="nav-trigger cursor-pointer text-sm font-bold text-ink transition-colors duration-150 hover:text-accent"
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        {t.a11y.menuToggle}
      </button>
    </div>
  </div>
</header>

<div
  id="nav-overlay"
  class="nav-overlay fixed inset-0 z-50 flex flex-col justify-center bg-base/96 backdrop-blur-lg"
  role="dialog"
  aria-modal="true"
  aria-label={t.a11y.mainNav}
  aria-hidden="true"
  inert
>
  <div class="mx-auto flex w-full max-w-6xl flex-col px-6 sm:px-10">
    <div class="flex justify-end pb-2 sm:pb-3">
      <button
        type="button"
        id="nav-overlay-close"
        class="flex cursor-pointer items-center gap-2 text-sm font-bold text-ink transition-colors duration-150 hover:text-accent"
      >
        {t.a11y.menuClose}
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav aria-label={t.a11y.mainNav} class="flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-overlay-link w-fit font-black uppercase text-ink transition-colors duration-200 hover:text-accent"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mt-8 flex flex-col gap-1 text-sm text-ink-muted">
      <a
        href={`mailto:${SITE.email}`}
        class="w-fit underline decoration-ink-muted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
      >
        {SITE.email}
      </a>
      <a
        href={SITE.social.linkedin}
        target="_blank"
        rel="noopener"
        class="w-fit underline decoration-ink-muted underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
      >
        {t.footer.linkedinLabel}
      </a>
    </div>
  </div>
</div>

<style>
  /*
    SEO-safe: içerik her zaman DOM'da; yalnızca opacity/transform/pointer-events
    toggle edilir, display:none YOK. Reduced-motion: transition tanımlanmaz,
    .is-open toggle'ı anında açar/kapar (CLAUDE.md §11 hard constraint).
  */
  .nav-overlay {
    opacity: 0;
    transform: scale(0.98);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-overlay {
      transition:
        opacity 300ms ease,
        transform 300ms ease;
    }
  }
  .nav-overlay.is-open {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .nav-overlay-link {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav-overlay-link {
      transition:
        color 200ms ease,
        transform 200ms ease;
    }
    .nav-overlay-link:hover {
      transform: translateX(0.5rem);
    }
  }
</style>

<script>
  const trigger = document.getElementById("nav-menu-trigger");
  const overlay = document.getElementById("nav-overlay");
  const closeBtn = document.getElementById("nav-overlay-close");

  if (trigger && overlay && closeBtn) {
    const focusableSelector = "a[href], button:not([disabled])";

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        close();
        return;
      }
      if (e.key !== "Tab") return;
      const focusables = Array.from(overlay.querySelectorAll<HTMLElement>(focusableSelector));
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    const onOverlayClick = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      // Link/buton dışındaki her yer "boşluk" sayılır — Close'a basmak
      // zorunda kalmadan overlay'in herhangi bir yerine tıklayarak kapatılabilir.
      if (!target.closest("a, button")) close();
    };

    function open() {
      overlay!.removeAttribute("inert");
      overlay!.setAttribute("aria-hidden", "false");
      overlay!.classList.add("is-open");
      document.documentElement.classList.add("nav-overlay-open");
      trigger!.setAttribute("aria-expanded", "true");
      overlay!.querySelector<HTMLElement>(focusableSelector)?.focus();
      document.addEventListener("keydown", onKeydown);
      overlay!.addEventListener("click", onOverlayClick);
    }

    function close() {
      overlay!.setAttribute("inert", "");
      overlay!.setAttribute("aria-hidden", "true");
      overlay!.classList.remove("is-open");
      document.documentElement.classList.remove("nav-overlay-open");
      trigger!.setAttribute("aria-expanded", "false");
      document.removeEventListener("keydown", onKeydown);
      overlay!.removeEventListener("click", onOverlayClick);
      trigger!.focus();
    }

    trigger.addEventListener("click", () => {
      if (overlay.classList.contains("is-open")) close();
      else open();
    });
    closeBtn.addEventListener("click", close);
  }
</script>
