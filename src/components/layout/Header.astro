---
/**
 * Site header'ı (CLAUDE.md §4). Logo sol; nav Packages/Process/Work/About;
 * CTA "Get a free audit" sağda. Mobil menü CSS-only (details/summary); küçük
 * inline script yalnızca progressive enhancement (dışarı tıkla / Escape ile kapat).
 * Script çalışmasa da menü tamamen işlevseldir.
 */
import { useTranslations, localizePath, type Locale } from "@/i18n";
import Button from "@/components/ui/Button.astro";

interface Props {
  locale: Locale;
  path: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { href: localizePath(locale, "/packages/"), label: t.nav.packages },
  { href: localizePath(locale, "/process/"), label: t.nav.process },
  { href: localizePath(locale, "/work/"), label: t.nav.work },
  { href: localizePath(locale, "/about/"), label: t.nav.about },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-base/80 backdrop-blur-md">
  <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a
      href={localizePath(locale, "/")}
      class="min-w-0 shrink text-lg font-bold tracking-tight"
      aria-label="v1be studio — home"
    >
      v1be<span class="text-accent"> studio</span><span class="hidden font-medium text-ink-muted md:inline"> | web design &amp; development</span>
    </a>

    <nav aria-label={t.a11y.mainNav} class="hidden items-center gap-6 md:flex lg:gap-8">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-ink-muted transition-colors duration-300 hover:text-ink"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <span class="hidden sm:block">
        <Button href={localizePath(locale, "/contact/")} size="sm">{t.nav.cta}</Button>
      </span>

      <details class="header-menu mobile-menu md:hidden" data-header-menu>
        <summary
          class="flex h-9 w-9 cursor-pointer list-none select-none items-center justify-center rounded-full border border-line text-ink-muted transition-colors duration-300 hover:border-ink-muted hover:text-ink"
          aria-label={t.a11y.menuToggle}
          title={t.a11y.menuToggle}
        >
          <svg
            aria-hidden="true"
            class="icon-open"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg
            aria-hidden="true"
            class="icon-close"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </summary>
        <nav
          aria-label={t.a11y.mainNav}
          class="absolute inset-x-0 top-full z-50 border-b border-t border-line bg-base shadow-xl shadow-base/60"
        >
          <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-4 sm:px-6">
            {navItems.map((item) => (
              <a
                href={item.href}
                class="rounded-xl px-3 py-2.5 text-sm font-medium text-ink-muted transition-colors duration-200 hover:bg-surface hover:text-ink"
              >
                {item.label}
              </a>
            ))}
            <Button href={localizePath(locale, "/contact/")} size="sm" class="mt-3">
              {t.nav.cta}
            </Button>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .header-menu summary::marker,
  .header-menu summary::-webkit-details-marker {
    display: none;
  }
  .header-menu[open] > summary {
    color: var(--color-ink);
    border-color: var(--color-ink-muted);
  }
  .mobile-menu .icon-close {
    display: none;
  }
  .mobile-menu[open] .icon-open {
    display: none;
  }
  .mobile-menu[open] .icon-close {
    display: block;
  }
</style>

<script>
  // Progressive enhancement: dışarı tıklama / Escape ile kapat.
  const menus = document.querySelectorAll<HTMLDetailsElement>("[data-header-menu]");
  const closeAll = (except?: HTMLDetailsElement) => {
    menus.forEach((m) => {
      if (m !== except) m.removeAttribute("open");
    });
  };
  menus.forEach((menu) => {
    menu.addEventListener("toggle", () => {
      if (menu.open) closeAll(menu);
    });
  });
  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Node)) return;
    const inside = Array.from(menus).some((m) => m.contains(e.target as Node));
    if (!inside) closeAll();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });
</script>
