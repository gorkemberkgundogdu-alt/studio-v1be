---
/**
 * Home-page cross-brand CTA for v1be.
 * Closing the panel leaves a compact tab in place so it can always be reopened.
 */
---

<aside class="v1be-promo" data-v1be-promo data-state="pending" aria-label="v1be">
  <div class="v1be-promo__panel">
    <button
      class="v1be-promo__close"
      type="button"
      data-v1be-promo-close
      aria-label="Minimize v1be"
    >
      <span aria-hidden="true">×</span>
    </button>

    <p class="v1be-promo__eyebrow">from <span>v1be</span></p>
    <h2>Turn visibility into a growth system.</h2>
    <p>
      v1be connects content, brand intelligence and AI automation in one human-approved platform.
    </p>
    <a class="v1be-promo__cta" href="https://v1be.io">
      Explore v1be <span aria-hidden="true">→</span>
    </a>
  </div>

  <button class="v1be-promo__tab" type="button" data-v1be-promo-open aria-expanded="false">
    <span>v1be</span>
    <span aria-hidden="true">↗</span>
  </button>
</aside>

<script>
  const promo = document.querySelector<HTMLElement>("[data-v1be-promo]");

  if (promo) {
    const closeButton = promo.querySelector<HTMLButtonElement>("[data-v1be-promo-close]");
    const openButton = promo.querySelector<HTMLButtonElement>("[data-v1be-promo-open]");

    const open = () => {
      promo.dataset.state = "open";
      openButton?.setAttribute("aria-expanded", "true");
    };

    const close = () => {
      promo.dataset.state = "closed";
      openButton?.setAttribute("aria-expanded", "false");
      openButton?.focus();
    };

    window.setTimeout(() => {
      if (promo.dataset.state === "pending") open();
    }, 3500);

    closeButton?.addEventListener("click", close);
    openButton?.addEventListener("click", open);
  }
</script>

<style>
  .v1be-promo {
    position: fixed;
    z-index: 60;
    top: clamp(7.5rem, 38vh, 20rem);
    right: 0;
    width: min(21.5rem, calc(100vw - 1rem));
    color: var(--color-ink);
    pointer-events: none;
  }

  .v1be-promo__panel,
  .v1be-promo__tab {
    pointer-events: auto;
    box-shadow: 0 18px 44px color-mix(in srgb, #0b061c 48%, transparent);
  }

  .v1be-promo__panel {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--color-accent) 46%, var(--color-line));
    border-right: 0;
    border-radius: 1.125rem 0 0 1.125rem;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-purple) 96%, black), var(--color-base));
    padding: 1.35rem 1.5rem 1.45rem;
    opacity: 0;
    transform: translateX(calc(100% + 1rem));
    transition: opacity 220ms ease, transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
    visibility: hidden;
  }

  .v1be-promo[data-state="open"] .v1be-promo__panel {
    opacity: 1;
    transform: translateX(0);
    visibility: visible;
  }

  .v1be-promo__close {
    position: absolute;
    top: 0.65rem;
    right: 0.75rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 9999px;
    color: var(--color-ink-muted);
    font-size: 1.25rem;
    line-height: 1;
    transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
  }

  .v1be-promo__close:hover {
    border-color: var(--color-line);
    background: color-mix(in srgb, var(--color-cream) 8%, transparent);
    color: var(--color-ink);
  }

  .v1be-promo__eyebrow {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .v1be-promo__eyebrow span,
  .v1be-promo__tab span:first-child {
    color: var(--color-accent);
  }

  .v1be-promo h2 {
    max-width: 16rem;
    margin: 0.8rem 2rem 0 0;
    font-size: clamp(1.15rem, 1rem + 0.75vw, 1.35rem);
    font-weight: 750;
    line-height: 1.16;
    letter-spacing: -0.025em;
  }

  .v1be-promo p:not(.v1be-promo__eyebrow) {
    margin: 0.75rem 0 0;
    color: var(--color-ink-muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .v1be-promo__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
    border-radius: 9999px;
    background: var(--color-accent);
    padding: 0.65rem 0.9rem;
    color: var(--color-base);
    font-size: 0.78rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 150ms ease, background-color 150ms ease;
  }

  .v1be-promo__cta:hover {
    transform: translateY(-1px);
    background: var(--color-accent-hot);
  }

  .v1be-promo__tab {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, var(--color-line));
    border-right: 0;
    border-radius: 0.9rem 0 0 0.9rem;
    background: var(--color-purple);
    padding: 0.7rem 0.8rem 0.7rem 0.95rem;
    color: var(--color-ink);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateX(1rem);
    transition: opacity 180ms ease, transform 220ms ease, background-color 150ms ease;
    visibility: hidden;
  }

  .v1be-promo__tab:hover {
    background: color-mix(in srgb, var(--color-purple) 82%, var(--color-accent));
  }

  .v1be-promo[data-state="closed"] .v1be-promo__tab {
    opacity: 1;
    transform: translateX(0);
    visibility: visible;
  }

  @media (max-width: 640px) {
    .v1be-promo {
      top: clamp(6.25rem, 34vh, 14rem);
      width: min(19.25rem, calc(100vw - 0.75rem));
    }

    .v1be-promo__panel {
      padding: 1.15rem 1.2rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v1be-promo__panel,
    .v1be-promo__tab,
    .v1be-promo__close,
    .v1be-promo__cta {
      transition: none;
    }
  }
</style>
