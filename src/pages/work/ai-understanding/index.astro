---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Button from "@/components/ui/Button.astro";
import ExperimentPipeline from "@/components/work/ExperimentPipeline.astro";
import EvidenceLedger from "@/components/work/EvidenceLedger.astro";
import KnownUnknown from "@/components/work/KnownUnknown.astro";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";
import { localizePath, useTranslations } from "@/i18n";

const locale = (Astro.props.locale ?? "en") as import("@/i18n").Locale;
const path = "/work/ai-understanding/";
const t = useTranslations(locale);
const lab = t.lab.lab002;
const crumbs = [
  { name: t.footer.nav.home, path: "/" },
  { name: t.nav.work, path: "/work/" },
  { name: lab.breadcrumb, path },
];
---

<BaseLayout
  title={lab.meta.title}
  description={lab.meta.description}
  {locale}
  {path}
  schemas={[
    webPageSchema({
      name: lab.hero.title,
      description: lab.meta.description,
      locale,
      path,
    }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <!-- Hero Section -->
  <section class="grid-texture border-b border-line">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:py-24 lg:grid-cols-[1.45fr_0.85fr] lg:items-end">
      <div data-reveal>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{lab.hero.eyebrow}</p>
        <h1 class="mt-4 max-w-4xl text-display font-extrabold">{lab.hero.title}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">{lab.hero.body}</p>
      </div>
      <aside class="rounded-3xl border border-line bg-surface/70 p-6" data-reveal>
        <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-accent">{lab.hero.summary}</p>
        <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-6">
          {lab.hero.metrics.map((metric) => (
            <div>
              <dt class="font-mono text-[0.6rem] uppercase tracking-wider text-ink-muted">{metric[0]}</dt>
              <dd class="mt-1 text-xl font-extrabold text-ink">{metric[1]}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-7 text-2xl font-black text-accent">{lab.hero.status}</p>
        <p class="mt-1 text-xs text-ink-muted">{lab.hero.footnote}</p>
      </aside>
    </div>
    <div class="border-t border-accent/40 bg-accent/[0.08] px-4 py-3 text-center font-mono text-xs font-bold uppercase tracking-[0.14em] text-accent">
      {lab.hero.caveat}
    </div>
  </section>

  <!-- 2. What We Test / 5 Dimensions (Lab 001 Tested Families Grid) -->
  <section aria-labelledby="tested-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="max-w-3xl" data-reveal>
        <h2 id="tested-title" class="text-h2 font-bold">{lab.tested.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">{lab.tested.intro}</p>
      </div>
      <div class="mt-10 grid gap-3 sm:grid-cols-2" data-reveal-group>
        {lab.tested.families.map((family, index) => (
          <article class="rounded-2xl border border-line bg-surface/40 p-5" data-reveal style={`--reveal-delay: ${index * 55}ms`}>
            <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{family[0]}</p>
            <p class="mt-4 text-sm leading-relaxed text-ink">{family[1]}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 border-t border-line pt-6">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-ink-muted">{lab.ui.checks}</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {lab.tested.checks.map((check) => (
            <li class="rounded-full border border-line px-3 py-1.5 font-mono text-xs text-ink-muted">{check}</li>
          ))}
        </ul>
        <p class="mt-5 text-xs leading-relaxed text-ink-muted">{lab.tested.note}</p>
      </div>
    </div>
  </section>

  <!-- 3. How We Evaluate / Experiment Pipeline (Lab 001 ExperimentPipeline Component) -->
  <section class="grid-texture border-y border-line" aria-labelledby="method-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="max-w-3xl" data-reveal>
        <h2 id="method-title" class="text-h2 font-bold">{lab.method.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">{lab.method.intro}</p>
      </div>
      <ExperimentPipeline stages={lab.method.stages} note={lab.method.note} label={lab.method.pipelineLabel} />
    </div>
  </section>

  <!-- 4. Frozen Source-of-Truth Ledger (Lab 001 EvidenceLedger Component) -->
  <section aria-labelledby="evidence-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="max-w-3xl" data-reveal>
        <h2 id="evidence-title" class="text-h2 font-bold">{lab.evidence.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">{lab.evidence.intro}</p>
      </div>
      <EvidenceLedger items={lab.evidence.items} observedLabel={lab.evidence.observedLabel} interpretationLabel={lab.evidence.interpretationLabel} />
    </div>
  </section>

  <!-- 5. Context Layers & Failure Taxonomy (Lab 001 Finding Light Section) -->
  <section class="bg-light-base text-light-ink" aria-labelledby="contexts-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="max-w-4xl" data-reveal>
        <h2 id="contexts-title" class="text-h2 font-bold">{lab.contexts.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-light-muted">{lab.contexts.body}</p>
      </div>

      <div class="mt-10 grid gap-3 lg:grid-cols-2" data-reveal-group>
        <article class="rounded-3xl border border-light-line p-6" data-reveal>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-light-muted">{lab.ui.before}</p>
          <ol class="mt-6 space-y-3">
            {lab.contexts.before.map((item, i) => (
              <li class="text-sm leading-relaxed">
                {item}
                {i < 2 && <span class="ml-2 text-green" aria-hidden="true">↓</span>}
              </li>
            ))}
          </ol>
        </article>

        <article class="rounded-3xl border border-green/40 bg-green/10 p-6" data-reveal>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-green">{lab.ui.fix}</p>
          <p class="mt-5 text-lg font-bold">{lab.contexts.fix}</p>
          <ol class="mt-6 space-y-3">
            {lab.contexts.after.map((item, i) => (
              <li class="text-sm leading-relaxed">
                {item}
                {i < 2 && <span class="ml-2 text-green" aria-hidden="true">↓</span>}
              </li>
            ))}
          </ol>
        </article>
      </div>

      <div class="mt-8 rounded-3xl border border-light-line bg-base p-6 text-ink" data-reveal>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{lab.contexts.patch}</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {lab.contexts.categories.map((cat) => (
            <div class="rounded-xl border border-line bg-surface/40 p-4">
              <p class="font-mono text-xs font-bold text-accent">{cat[0]}</p>
              <p class="mt-2 text-xs leading-relaxed text-ink-muted">{cat[1]}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="mt-8 max-w-3xl text-lg font-bold leading-relaxed">{lab.contexts.closing}</p>
      <a href={localizePath(locale, "/process/")} class="mt-6 inline-block font-bold text-green underline underline-offset-4">{lab.contexts.link}</a>
    </div>
  </section>

  <!-- 6. Result Status / Absence of Evidence (Lab 001 Rate Limit Section) -->
  <section aria-labelledby="rate-title">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 md:py-24">
      <div data-reveal>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-ink-muted">{lab.rate.label}</p>
        <h2 id="rate-title" class="mt-3 text-h2 font-bold">{lab.rate.title}</h2>
      </div>
      <div class="mt-8 grid gap-6 border-y border-line py-8 sm:grid-cols-[auto_1fr]" data-reveal>
        <p class="font-mono text-5xl sm:text-6xl font-black text-ink-muted">{lab.rate.code}</p>
        <div>
          <p class="font-bold text-ink">{lab.rate.observed}</p>
          <p class="mt-5 font-mono text-xs uppercase tracking-wider text-ink-muted">{lab.ui.notProven}</p>
          <ul class="mt-3 space-y-2 text-sm text-ink-muted">
            {lab.rate.notProven.map((item) => (
              <li>— {item}</li>
            ))}
          </ul>
        </div>
      </div>
      <p class="mt-6 text-sm leading-relaxed text-ink-muted">{lab.rate.closing}</p>
    </div>
  </section>

  <!-- 7. 20-Prompt Evaluation Protocol Ledger (Editorial Ledger Style) -->
  <section class="grid-texture border-y border-line" aria-labelledby="prompts-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="max-w-3xl" data-reveal>
        <h2 id="prompts-title" class="text-h2 font-bold">{lab.promptsSection.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">{lab.promptsSection.intro}</p>
      </div>

      <ol class="mt-10 divide-y divide-line overflow-hidden rounded-3xl border border-line bg-surface/20" data-reveal-group>
        {lab.promptsSection.prompts.map((p, idx) => (
          <li class="grid gap-6 p-6 sm:p-7 md:grid-cols-[11rem_1.4fr_1fr] md:items-start transition-colors hover:bg-surface/40" data-reveal style={`--reveal-delay: ${(idx % 5) * 45}ms`}>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold text-accent">{p.id}</span>
                <span class="rounded-full border border-line px-2 py-0.5 font-mono text-[0.58rem] uppercase text-ink-muted">{p.dimension}</span>
              </div>
              <span class="mt-3 inline-block rounded-full border border-line bg-base/60 px-2.5 py-1 font-mono text-[0.6rem] uppercase tracking-wider text-ink-muted">{p.type}</span>
            </div>

            <div>
              <p class="text-sm font-bold text-ink sm:text-base leading-snug">"{p.prompt}"</p>
              <div class="mt-3 rounded-xl border border-line/60 bg-base/40 p-3">
                <p class="font-mono text-[0.6rem] uppercase tracking-wider text-accent">{lab.ui.truthLabel}</p>
                <p class="mt-1 text-xs leading-relaxed text-ink-muted">{p.truth}</p>
              </div>
            </div>

            <div>
              <p class="font-mono text-[0.6rem] uppercase tracking-wider text-ink-muted">{lab.ui.ruleLabel}</p>
              <p class="mt-1.5 text-xs leading-relaxed text-ink-muted">{p.rule}</p>
              <div class="mt-4 flex items-center justify-between border-t border-line/50 pt-3">
                <span class="font-mono text-[0.58rem] uppercase tracking-wider text-ink-muted">{lab.ui.statusLabel}</span>
                <span class="inline-flex items-center rounded-full border border-line bg-surface/80 px-2.5 py-0.5 font-mono text-[0.62rem] font-bold text-ink-muted">
                  {p.status}
                </span>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 8. Known vs Unknown (Lab 001 KnownUnknown Component) -->
  <section class="grid-texture border-y border-line" aria-labelledby="knowledge-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <h2 id="knowledge-title" class="text-h2 font-bold" data-reveal>{lab.knowledge.title}</h2>
      <KnownUnknown
        knownLabel={lab.knowledge.knownLabel}
        unknownLabel={lab.knowledge.unknownLabel}
        known={lab.knowledge.known}
        unknown={lab.knowledge.unknown}
        closing={lab.knowledge.closing}
        knownBadge={lab.knowledge.knownBadge}
        unknownBadge={lab.knowledge.unknownBadge}
      />
    </div>
  </section>

  <!-- 9. Conclusion & Impact (Lab 001 Centered Conclusion) -->
  <section aria-labelledby="conclusion-title">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 md:py-24" data-reveal>
      <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{lab.conclusion.eyebrow}</p>
      <h2 id="conclusion-title" class="mt-4 text-h2 font-bold">
        {lab.conclusion.before}<span class="text-accent">{lab.conclusion.accent}</span>
      </h2>
      {lab.conclusion.body.map((line) => (
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">{line}</p>
      ))}
      <div class="mt-10 grid gap-3 text-left sm:grid-cols-2">
        <div class="rounded-2xl border border-accent/45 p-5">
          <p class="font-mono text-xs uppercase text-accent">{lab.ui.supported}</p>
          <p class="mt-3 font-bold text-ink">{lab.conclusion.supported}</p>
        </div>
        <div class="rounded-2xl border border-line p-5">
          <p class="font-mono text-xs uppercase text-ink-muted">{lab.ui.notEstablished}</p>
          <p class="mt-3 text-sm text-ink-muted">{lab.conclusion.notEstablished.join(" · ")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. Standardization Impact (Lab 001 Light Changes Grid) -->
  <section class="bg-light-base text-light-ink" aria-labelledby="changes-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <h2 id="changes-title" class="text-h2 font-bold" data-reveal>{lab.changes.title}</h2>
      <ol class="mt-10 grid overflow-hidden rounded-3xl border border-light-line md:grid-cols-3" data-reveal-group>
        {lab.changes.items.map((item) => (
          <li class="border-b border-light-line p-6 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0" data-reveal>
            <p class="font-mono text-xs text-green">{item[0]}</p>
            <h3 class="mt-6 text-lg font-extrabold">{item[1]}</h3>
            <p class="mt-3 text-sm leading-relaxed text-light-muted">{item[2]}</p>
          </li>
        ))}
      </ol>
      <p class="mt-10 text-center font-mono text-lg font-bold tracking-wider text-green">{lab.changes.equation}</p>
    </div>
  </section>

  <!-- 11. Lab Series Progression & CTA (Lab 001 Progression & CTA Layout) -->
  <section class="grid-texture" aria-labelledby="series-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="max-w-3xl" data-reveal>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">Studio Research Sequence</p>
        <h2 id="series-title" class="mt-3 text-h2 font-bold">{lab.series.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-muted">{lab.series.intro}</p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {lab.series.items.map((item, idx) => {
          const isCurrent = item.id === "LAB 002";
          const hasLink = item.href !== "" && !isCurrent;
          return (
            <article
              class:list={[
                "flex flex-col justify-between rounded-3xl border p-6",
                isCurrent
                  ? "border-accent bg-accent/[0.08]"
                  : item.href
                    ? "border-line bg-surface/45"
                    : "border-dashed border-line/70 bg-surface/20",
              ]}
              data-reveal
              style={`--reveal-delay: ${idx * 50}ms`}
            >
              <div>
                <span class:list={["font-mono text-xs font-bold", isCurrent ? "text-accent" : "text-ink-muted"]}>{item.id}</span>
                <h3 class="mt-3 text-lg font-bold text-ink">{item.title}</h3>
                <p class="mt-2 font-mono text-[0.65rem] text-accent/90">{item.status}</p>
                <p class="mt-3 text-xs leading-relaxed text-ink-muted">{item.desc}</p>
              </div>
              <div class="mt-6 border-t border-line/50 pt-4">
                {hasLink ? (
                  <a href={localizePath(locale, item.href)} class="font-mono text-xs font-bold text-accent underline underline-offset-4">{item.link}</a>
                ) : (
                  <span class="font-mono text-xs text-ink-muted/70">{item.link}</span>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div class="mx-auto mt-20 max-w-3xl text-center" data-reveal>
        <h2 class="text-h2 font-bold">{lab.cta.title}</h2>
        <div class="mt-8">
          <Button href={localizePath(locale, "/contact/")}>{lab.cta.button}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
