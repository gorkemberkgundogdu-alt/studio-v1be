---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Button from "@/components/ui/Button.astro";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";
import { localizePath, useTranslations } from "@/i18n";

const locale = (Astro.props.locale ?? "en") as import("@/i18n").Locale;
const path = "/work/studio-v1be/";
const t = useTranslations(locale);
const c = t.work.studioCase;
const crumbs = [
  { name: t.footer.nav.home, path: "/" },
  { name: t.nav.work, path: "/work/" },
  { name: c.breadcrumbLabel, path },
];
---

<BaseLayout title={c.meta.title} description={c.meta.description} {locale} {path} schemas={[webPageSchema({ name: c.title, description: c.meta.description, locale, path }), breadcrumbSchema(crumbs, locale)]}>
  <Breadcrumb {locale} items={crumbs} />
  <section class="grid-texture">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">{c.eyebrow}</p>
      <h1 class="mt-4 text-display font-extrabold">{c.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">{c.subtitle}</p>
      {c.sections.map((section) => <div class="mt-12"><h2 class="text-xl font-bold text-ink">{section.heading}</h2><p class="mt-3 leading-relaxed text-ink-muted">{section.body}</p></div>)}
      <div class="mt-12"><Button href={localizePath(locale, "/contact/")}>{c.cta}</Button></div>
    </div>
  </section>
</BaseLayout>
