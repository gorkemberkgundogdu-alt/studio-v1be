---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Button from "@/components/ui/Button.astro";
import CaseRelationshipMap from "@/components/work/CaseRelationshipMap.astro";
import GEOGlossaryTerm from "@/components/work/GEOGlossaryTerm.astro";
import MethodologyLoop from "@/components/work/MethodologyLoop.astro";
import KnownUnknown from "@/components/work/KnownUnknown.astro";
import BrowserScreenshot from "@/components/work/BrowserScreenshot.astro";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";
import { localizePath, useTranslations } from "@/i18n";
import { estimateReadingMinutes } from "@/lib/reading-time";

const locale = (Astro.props.locale ?? "en") as import("@/i18n").Locale;
const path = "/work/studio-v1be/";
const t = useTranslations(locale);
// Case 002 is being redesigned from the English source. Keep the existing
// Turkish document routable until its localized content is supplied.
const englishCase = useTranslations("en").work.studioCase;
const c = locale === "en"
  ? t.work.studioCase
  : { ...englishCase, meta: t.work.studioCase.meta, breadcrumbLabel: t.work.studioCase.breadcrumbLabel };
const readingTime = estimateReadingMinutes([
  ...c.hero.narrative, ...c.origin.narrative, ...c.design.narrative, ...c.discovery.narrative,
  ...c.conversion.narrative, ...c.development.narrative, c.afterDeploy.lead, ...c.afterDeploy.narrative,
  c.lab.intro, ...c.lab.stages.map((stage) => stage[1]), c.lab.qualification, ...c.service.narrative,
]);
const crumbs = [{ name: t.footer.nav.home, path: "/" }, { name: t.nav.work, path: "/work/" }, { name: c.breadcrumbLabel, path }];
---

<BaseLayout title={c.meta.title} description={c.meta.description} {locale} {path} schemas={[webPageSchema({ name: c.hero.title, description: c.meta.description, locale, path }), breadcrumbSchema(crumbs, locale)]}>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture border-b border-line" aria-labelledby="studio-case-title">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
      <div data-reveal>
        <p class="font-mono text-sm font-bold uppercase tracking-widest text-accent">{c.hero.eyebrow} · {readingTime} MIN READ</p>
        <h1 id="studio-case-title" class="mt-4 max-w-3xl font-extrabold" style="font-size: clamp(2.25rem, 1.5rem + 4vw, 4.5rem); line-height: 1.02; letter-spacing: -0.04em;">{c.hero.title}</h1>
        {c.hero.narrative.map((paragraph) => <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">{paragraph}</p>)}
        {c.hero.image && <figure class="mt-10"><BrowserScreenshot image={c.hero.image} alt={c.hero.imageAlt} priority /><figcaption class="mt-4 font-mono text-xs text-ink-muted">Live v1be studio landing experience</figcaption></figure>}
      </div>
    </div>
  </section>

  <section class="border-b border-line" aria-labelledby="origin-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-center"><div data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{c.origin.eyebrow}</p><h2 id="origin-title" class="mt-3 text-h2 font-bold">{c.origin.title}</h2>{c.origin.narrative.map((paragraph) => <p class="mt-5 leading-relaxed text-ink-muted">{paragraph}</p>)}<a href={localizePath(locale, "/work/v1be-io/")} class="mt-7 inline-block font-bold text-accent underline underline-offset-4">{c.origin.link} →</a></div><CaseRelationshipMap nodes={c.origin.map} /></div></div></section>

  <section class="bg-light-base text-light-ink" aria-labelledby="design-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="max-w-3xl" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-green">{c.design.eyebrow}</p><h2 id="design-title" class="mt-3 text-h2 font-bold">{c.design.title}</h2></div><div class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-start"><div class="space-y-5 text-lg leading-relaxed text-light-muted" data-reveal>{c.design.narrative.map((paragraph) => <p>{paragraph}</p>)}</div><div class="grid gap-4" data-reveal-group>{c.design.visuals.map((visual, index) => <article class:list={["rounded-[1.5rem] border p-6", index === 0 ? "border-green/45 bg-white/60" : "border-light-line bg-white/35"]} data-reveal>{visual.image && <figure class="mb-6"><BrowserScreenshot image={visual.image} alt={visual.alt} /></figure>}<p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-green">{visual.label}</p><h3 class="mt-8 text-2xl font-extrabold text-light-ink">{visual.title}</h3><p class="mt-4 leading-relaxed text-light-muted">{visual.body}</p></article>)}</div></div></div></section>

  <section class="grid-texture border-b border-line" aria-labelledby="discovery-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="max-w-3xl" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{c.discovery.eyebrow}</p><h2 id="discovery-title" class="mt-3 text-h2 font-bold">{c.discovery.title}</h2>{c.discovery.narrative.slice(0, 4).map((paragraph) => <p class="mt-5 leading-relaxed text-ink-muted">{paragraph}</p>)}<p class="mt-5 leading-relaxed text-ink-muted">{c.discovery.narrative[4]} <GEOGlossaryTerm term="Generative Engine Optimization" abbreviation="GEO" definition={c.discovery.definition} />: making the site easier for AI systems to access, understand and correctly connect with the v1be brand.</p><p class="mt-5 leading-relaxed text-ink-muted">{c.discovery.narrative[5]}</p></div><ol class="mt-12 grid gap-3 sm:grid-cols-5" aria-label="Discovery path" data-reveal-group>{c.discovery.flow.map((item, index) => <li class="relative rounded-2xl border border-line bg-surface/50 p-4 text-center font-mono text-xs font-bold uppercase tracking-[0.1em]" data-reveal><span>{item}</span>{index < c.discovery.flow.length - 1 && <span class="mt-4 block text-accent sm:absolute sm:-right-4 sm:top-1/2 sm:mt-0 sm:-translate-y-1/2" aria-hidden="true">→</span>}</li>)}</ol><dl class="mt-5 grid gap-3 md:grid-cols-3" data-reveal-group>{c.discovery.concepts.map((concept) => <div class="rounded-2xl border border-line bg-base/70 p-5" data-reveal><dt class="font-mono text-xs font-bold tracking-[0.14em] text-accent">{concept[0]}</dt><dd class="mt-4 text-sm leading-relaxed text-ink-muted">{concept[1]}</dd></div>)}</dl></div></section>

  <section class="border-b border-line" aria-labelledby="conversion-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="grid gap-10 lg:grid-cols-[0.82fr_1.18fr]"><div data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{c.conversion.eyebrow}</p><h2 id="conversion-title" class="mt-3 text-h2 font-bold">{c.conversion.title}</h2>{c.conversion.narrative.map((paragraph) => <p class="mt-5 leading-relaxed text-ink-muted">{paragraph}</p>)}</div><nav class="rounded-[1.75rem] border border-line bg-surface/45 p-6 sm:p-8" aria-label="Conversion architecture" data-reveal><p class="font-mono text-xs font-bold tracking-[0.16em] text-ink-muted">{c.conversion.sources}</p><p class="mt-6 text-center font-mono text-accent">↓</p><ol class="mt-4 space-y-3 text-center">{c.conversion.steps.map((step) => <li class="rounded-xl border border-line bg-base/70 p-4 font-bold">{step}</li>)}</ol><div class="my-6 text-center font-mono text-accent">↓</div><ul class="grid gap-3 sm:grid-cols-3">{c.conversion.destinations.map((destination) => <li><a href={localizePath(locale, destination[2])} class="cta-lift block rounded-xl border border-line bg-base p-4 text-center hover:border-accent"><span class="font-mono text-xs font-bold text-accent">{destination[0]}</span><strong class="mt-3 block">{destination[1]}</strong></a></li>)}</ul><p class="mt-7 text-center font-mono text-xs font-bold tracking-[0.12em] text-ink-muted">{c.conversion.sequence}</p></nav></div></div></section>

  <section class="bg-light-base text-light-ink" aria-labelledby="development-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="max-w-3xl" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-green">{c.development.eyebrow}</p><h2 id="development-title" class="mt-3 text-h2 font-bold">{c.development.title}</h2></div><div class="mt-10 grid gap-8 lg:grid-cols-[1fr_0.9fr]"><div class="space-y-5 leading-relaxed text-light-muted" data-reveal>{c.development.narrative.map((paragraph) => <p>{paragraph}</p>)}</div><div class="grid gap-px overflow-hidden rounded-3xl border border-light-line bg-light-line sm:grid-cols-2" data-reveal-group>{c.development.stack.map((item) => <div class="bg-light-base p-6" data-reveal><p class="font-mono text-xs font-bold tracking-[0.16em] text-green">{item[0]}</p><p class="mt-5 font-bold">{item[1]}</p></div>)}<div class="bg-light-base p-6 sm:col-span-2" data-reveal><p class="font-mono text-xs font-bold tracking-[0.16em] text-green">{c.development.annotation}</p></div></div></div></div></section>

  <section class="grid-texture border-b border-line" aria-labelledby="after-deploy-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="grid gap-10 lg:grid-cols-[0.78fr_1.22fr]"><div data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{c.afterDeploy.eyebrow}</p><h2 id="after-deploy-title" class="mt-3 text-h2 font-bold">{c.afterDeploy.title}</h2><p class="mt-6 border-l-2 border-accent pl-4 text-xl font-bold leading-relaxed">{c.afterDeploy.lead}</p>{c.afterDeploy.narrative.map((paragraph) => <p class="mt-5 leading-relaxed text-ink-muted">{paragraph}</p>)}</div><MethodologyLoop steps={c.afterDeploy.loop} /></div></div></section>

  <section class="border-b border-line" aria-labelledby="lab-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="max-w-3xl" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{c.lab.eyebrow}</p><h2 id="lab-title" class="mt-3 text-h2 font-bold">{c.lab.intro}</h2></div><ol class="mt-10 grid overflow-hidden rounded-3xl border border-line md:grid-cols-4" aria-label="Lab 001 evidence progression" data-reveal-group>{c.lab.stages.map((stage, index) => <li class="border-b border-line bg-surface/35 p-6 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0" data-reveal><p class="font-mono text-xs font-bold tracking-[0.16em] text-accent">0{index + 1} · {stage[0]}</p><p class="mt-6 text-sm leading-relaxed text-ink-muted">{stage[1]}</p></li>)}</ol><div class="mt-5 grid gap-4 rounded-2xl border border-accent/45 bg-accent/[0.07] p-6 md:grid-cols-[auto_1fr] md:items-center" data-reveal><p class="font-mono text-3xl font-black text-accent">{c.lab.result}</p><p class="text-sm font-medium leading-relaxed text-ink">{c.lab.qualification}</p></div><a href={localizePath(locale, "/work/ai-crawlability/")} class="mt-7 inline-block font-bold text-accent underline underline-offset-4">{c.lab.cta} →</a></div></section>

  <section class="bg-light-base text-light-ink" aria-labelledby="state-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-green" data-reveal>{c.state.eyebrow}</p><h2 id="state-title" class="mt-3 text-h2 font-bold" data-reveal>{c.state.title}</h2><KnownUnknown knownLabel={c.state.establishedLabel} unknownLabel={c.state.measuringLabel} known={c.state.established} unknown={c.state.measuring} closing={c.state.note} /></div></section>

  <section class="grid-texture" aria-labelledby="service-title"><div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 md:py-28" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{c.service.eyebrow}</p><h2 id="service-title" class="mt-3 text-h2 font-bold">{c.service.title}</h2>{c.service.narrative.map((paragraph) => <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">{paragraph}</p>)}<div class="mt-10 flex flex-wrap justify-center gap-4"><Button href={localizePath(locale, "/contact/")}>{c.service.primary}</Button><Button href={localizePath(locale, "/packages/")} variant="surface">{c.service.secondary}</Button></div></div></section>
</BaseLayout>
