---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Button from "@/components/ui/Button.astro";
import ExperimentPipeline from "@/components/work/ExperimentPipeline.astro";
import EvidenceLedger from "@/components/work/EvidenceLedger.astro";
import KnownUnknown from "@/components/work/KnownUnknown.astro";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";
import { localizePath, useTranslations } from "@/i18n";

const locale = (Astro.props.locale ?? "en") as import("@/i18n").Locale;
const path = "/work/ai-crawlability/";
const t = useTranslations(locale);
const lab = t.lab;
const crumbs = [{ name: t.footer.nav.home, path: "/" }, { name: t.nav.work, path: "/work/" }, { name: lab.breadcrumb, path }];
---
<BaseLayout title={lab.meta.title} description={lab.meta.description} {locale} {path} schemas={[webPageSchema({ name: lab.hero.title, description: lab.meta.description, locale, path }), breadcrumbSchema(crumbs, locale)]}>
  <Breadcrumb {locale} items={crumbs} />
  <section class="grid-texture border-b border-line"><div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:py-24 lg:grid-cols-[1.45fr_0.85fr] lg:items-end"><div data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{lab.hero.eyebrow}</p><h1 class="mt-4 max-w-4xl text-display font-extrabold">{lab.hero.title}</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">{lab.hero.body}</p></div><aside class="rounded-3xl border border-line bg-surface/70 p-6" data-reveal><p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-accent">{lab.hero.summary}</p><dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-6">{lab.hero.metrics.map((metric) => <div><dt class="font-mono text-[0.6rem] uppercase tracking-wider text-ink-muted">{metric[0]}</dt><dd class="mt-1 text-xl font-extrabold text-ink">{metric[1]}</dd></div>)}</dl><p class="mt-7 text-2xl font-black text-accent">{lab.hero.status}</p><p class="mt-1 text-xs text-ink-muted">{lab.hero.footnote}</p></aside></div><div class="border-t border-accent/40 bg-accent/[0.08] px-4 py-3 text-center font-mono text-xs font-bold uppercase tracking-[0.14em] text-accent">{lab.hero.caveat}</div></section>

  <section aria-labelledby="tested-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="max-w-3xl" data-reveal><h2 id="tested-title" class="text-h2 font-bold">{lab.tested.title}</h2><p class="mt-5 text-lg leading-relaxed text-ink-muted">{lab.tested.intro}</p></div><div class="mt-10 grid gap-3 sm:grid-cols-2" data-reveal-group>{lab.tested.families.map((family, index) => <article class="rounded-2xl border border-line bg-surface/40 p-5" data-reveal style={`--reveal-delay: ${index * 55}ms`}><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{family[0]}</p><p class="mt-4 text-sm leading-relaxed text-ink">{family[1]}</p></article>)}</div><div class="mt-8 border-t border-line pt-6"><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-ink-muted">{lab.ui.checks}</p><ul class="mt-4 flex flex-wrap gap-2">{lab.tested.checks.map((check) => <li class="rounded-full border border-line px-3 py-1.5 font-mono text-xs text-ink-muted">{check}</li>)}</ul><p class="mt-5 text-xs leading-relaxed text-ink-muted">{lab.tested.note}</p></div></div></section>

<section class="grid-texture border-y border-line" aria-labelledby="method-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="max-w-3xl" data-reveal><h2 id="method-title" class="text-h2 font-bold">{lab.method.title}</h2><p class="mt-5 text-lg leading-relaxed text-ink-muted">{lab.method.intro}</p></div><ExperimentPipeline stages={lab.method.stages} note={lab.method.note} label={lab.method.pipelineLabel} /></div></section>

<section aria-labelledby="evidence-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><h2 id="evidence-title" class="text-h2 font-bold" data-reveal>{lab.evidence.title}</h2><EvidenceLedger items={lab.evidence.items} observedLabel={lab.evidence.observedLabel} interpretationLabel={lab.evidence.interpretationLabel} /></div></section>

  <section class="bg-light-base text-light-ink" aria-labelledby="finding-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="max-w-4xl" data-reveal><h2 id="finding-title" class="text-h2 font-bold">{lab.finding.title}</h2><p class="mt-5 text-lg leading-relaxed text-light-muted">{lab.finding.body}</p></div><div class="mt-10 grid gap-3 lg:grid-cols-2" data-reveal-group><article class="rounded-3xl border border-light-line p-6" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-light-muted">{lab.ui.before}</p><ol class="mt-6 space-y-3">{lab.finding.before.map((item, i) => <li class="text-sm leading-relaxed">{item}{i < 2 && <span class="ml-2 text-green" aria-hidden="true">↓</span>}</li>)}</ol></article><article class="rounded-3xl border border-green/40 bg-green/10 p-6" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-green">{lab.ui.fix}</p><p class="mt-5 text-lg font-bold">{lab.finding.fix}</p><ol class="mt-6 space-y-3">{lab.finding.after.map((item, i) => <li class="text-sm leading-relaxed">{item}{i < 2 && <span class="ml-2 text-green" aria-hidden="true">↓</span>}</li>)}</ol></article></div><div class="mt-8 rounded-3xl border border-light-line bg-base p-6 text-ink" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{lab.finding.patch}</p><div class="mt-5 grid gap-4 md:grid-cols-2"><pre class="overflow-x-auto rounded-xl border border-line p-4 text-xs text-ink-muted"><code>{lab.finding.beforeCode}</code></pre><pre class="overflow-x-auto rounded-xl border border-accent/45 p-4 text-xs text-ink"><code>{lab.finding.afterCode}</code></pre></div><div class="mt-5 grid gap-2 text-sm font-bold sm:grid-cols-2"><p>{lab.finding.js[0]}</p><p class="text-accent">{lab.finding.js[1]}</p></div></div><p class="mt-8 max-w-3xl text-lg font-bold leading-relaxed">{lab.finding.closing}</p><a href={localizePath(locale, "/process/")} class="mt-6 inline-block font-bold text-green underline underline-offset-4">{lab.finding.link}</a></div></section>

  <section aria-labelledby="rate-title"><div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 md:py-24"><div data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-ink-muted">{lab.rate.label}</p><h2 id="rate-title" class="mt-3 text-h2 font-bold">{lab.rate.title}</h2></div><div class="mt-8 grid gap-6 border-y border-line py-8 sm:grid-cols-[auto_1fr]" data-reveal><p class="font-mono text-6xl font-black text-ink-muted">429</p><div><p class="font-bold text-ink">{lab.rate.observed}</p><p class="mt-5 font-mono text-xs uppercase tracking-wider text-ink-muted">{lab.ui.notProven}</p><ul class="mt-3 space-y-2 text-sm text-ink-muted">{lab.rate.notProven.map((item) => <li>— {item}</li>)}</ul></div></div><p class="mt-6 text-sm leading-relaxed text-ink-muted">{lab.rate.closing}</p></div></section>

  <section class="grid-texture border-y border-line" aria-labelledby="knowledge-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><h2 id="knowledge-title" class="text-h2 font-bold" data-reveal>{lab.knowledge.title}</h2><KnownUnknown {...lab.knowledge} /></div></section>

  <section aria-labelledby="conclusion-title"><div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 md:py-24" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{lab.conclusion.eyebrow}</p><h2 id="conclusion-title" class="mt-4 text-h2 font-bold">{lab.conclusion.before}<span class="text-accent">{lab.conclusion.accent}</span></h2>{lab.conclusion.body.map((line) => <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">{line}</p>)}<div class="mt-10 grid gap-3 text-left sm:grid-cols-2"><div class="rounded-2xl border border-accent/45 p-5"><p class="font-mono text-xs uppercase text-accent">{lab.ui.supported}</p><p class="mt-3 font-bold">{lab.conclusion.supported}</p></div><div class="rounded-2xl border border-line p-5"><p class="font-mono text-xs uppercase text-ink-muted">{lab.ui.notEstablished}</p><p class="mt-3 text-sm text-ink-muted">{lab.conclusion.notEstablished.join(" · ")}</p></div></div></div></section>

  <section class="bg-light-base text-light-ink" aria-labelledby="changes-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><h2 id="changes-title" class="text-h2 font-bold" data-reveal>{lab.changes.title}</h2><ol class="mt-10 grid overflow-hidden rounded-3xl border border-light-line md:grid-cols-3" data-reveal-group>{lab.changes.items.map((item) => <li class="border-b border-light-line p-6 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0" data-reveal><p class="font-mono text-xs text-green">{item[0]}</p><h3 class="mt-6 text-lg font-extrabold">{item[1]}</h3><p class="mt-3 text-sm leading-relaxed text-light-muted">{item[2]}</p></li>)}</ol><p class="mt-10 text-center font-mono text-lg font-bold tracking-wider text-green">{lab.changes.equation}</p></div></section>

  <section class="grid-texture" aria-labelledby="related-title"><div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24"><div class="grid gap-3 lg:grid-cols-2"><article class="rounded-3xl border border-line bg-surface/45 p-7" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">{lab.related.label}</p><h2 id="related-title" class="mt-5 text-2xl font-bold">{lab.related.body}</h2><a href={localizePath(locale, "/work/studio-v1be/")} class="mt-8 inline-block font-bold text-accent underline underline-offset-4">{lab.related.link}</a></article><article class="rounded-3xl border border-dashed border-line p-7" data-reveal><p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-ink-muted">{lab.next.eyebrow}</p><p class="mt-5 font-mono text-sm text-accent">{lab.next.label}</p><h2 class="mt-2 text-2xl font-bold">{lab.next.title}</h2><p class="mt-4 leading-relaxed text-ink-muted">{lab.next.body}</p><ul class="mt-6 space-y-2 font-mono text-xs text-ink-muted">{lab.next.metrics.map((metric) => <li>{metric}</li>)}</ul><a href={localizePath(locale, "/work/ai-understanding/")} class="mt-6 inline-block font-mono text-xs font-bold text-accent underline underline-offset-4">{lab.next.note} →</a></article></div><div class="mx-auto mt-20 max-w-3xl text-center" data-reveal><h2 class="text-h2 font-bold">{lab.cta.title}</h2><div class="mt-8"><Button href={localizePath(locale, "/contact/")}>{lab.cta.button}</Button></div></div></div></section>
</BaseLayout>
