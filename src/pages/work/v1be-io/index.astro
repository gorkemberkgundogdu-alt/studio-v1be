---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import BrowserScreenshot from "@/components/work/BrowserScreenshot.astro";
import { useTranslations } from "@/i18n";
import { SITE } from "@/config/site";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";

const locale = "en" as const;
const path = "/work/v1be-io/";
const t = useTranslations(locale);
const cs = t.work.caseStudy;

const crumbs = [
  { name: "Home", path: "/" },
  { name: t.nav.work, path: "/work/" },
  { name: cs.breadcrumbLabel, path },
];

---

<BaseLayout
  title={cs.meta.title}
  description={cs.meta.description}
  {locale}
  {path}
  schemas={[
    webPageSchema({ name: cs.hero.title, description: cs.meta.description, locale, path }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture border-b border-line">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end" data-reveal-group>
          <div data-reveal>
            <p class="font-mono text-sm font-bold uppercase tracking-widest text-accent">{cs.hero.eyebrow}</p>
            <h1
              class="mt-4 max-w-4xl font-extrabold"
              style="font-size: clamp(1.75rem, 1.2rem + 3.2vw, 3.5rem); line-height: 1.05; letter-spacing: -0.03em;"
            >
              {cs.hero.title}
            </h1>
            <p class="mt-6 max-w-3xl text-lg font-medium leading-relaxed text-ink-muted md:text-xl">{cs.hero.subtitle}</p>
          </div>

          <div class="lg:justify-self-end" data-reveal style="--reveal-delay: 80ms">
            <div class="flex flex-wrap gap-3 lg:justify-end">
              <a
                href={SITE.parentOrg.url}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-lift inline-flex h-12 items-center justify-center rounded-full bg-accent px-7 text-base font-bold text-(--color-base)"
              >
                {cs.hero.primaryCta} <span class="ml-2" aria-hidden="true">↗</span>
              </a>
              <Button href={cs.hero.secondaryHref} variant="surface">{cs.hero.secondaryCta}</Button>
            </div>
          </div>
        </div>

        <figure class="mt-12" data-reveal style="--reveal-delay: 120ms">
          <BrowserScreenshot image={cs.hero.image} alt={cs.hero.imageAlt} status={cs.hero.liveLabel} priority />
          <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-2 font-mono text-[0.65rem] font-bold uppercase tracking-[0.14em] text-ink-muted">
            <span>{cs.hero.figureCaption}</span>
            <span class="text-accent">{cs.hero.figureProof}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="border-b border-line" aria-labelledby="case-summary-title">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
        <div class="max-w-4xl" data-reveal>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{cs.summary.eyebrow}</p>
          <h2 id="case-summary-title" class="mt-3 text-h2 font-bold">{cs.summary.title}</h2>
          <p class="mt-5 max-w-3xl text-lg font-medium leading-relaxed text-ink-muted">{cs.summary.description}</p>
        </div>

        <div class="mt-10 grid gap-3 md:grid-cols-3" data-reveal-group>
          {cs.summary.cards.map((card, index) => (
            <article class="rounded-2xl border border-line bg-surface/60 p-6" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span class="font-mono text-xs font-bold text-accent">0{index + 1}</span>
              <p class="mt-8 font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-ink-muted">{card.label}</p>
              <h3 class="mt-2 text-xl font-extrabold">{card.title}</h3>
              <p class="mt-3 text-sm font-medium leading-relaxed text-ink-muted">{card.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="visual-walkthrough" class="bg-light-base text-light-ink" aria-labelledby="visual-walkthrough-title">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
        <div class="max-w-4xl" data-reveal>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-green">{cs.walkthrough.eyebrow}</p>
          <h2 id="visual-walkthrough-title" class="mt-3 text-h2 font-bold">{cs.walkthrough.title}</h2>
          <p class="mt-5 max-w-3xl text-lg font-medium leading-relaxed text-light-muted">{cs.walkthrough.description}</p>
        </div>

        <div class="mt-12 space-y-14 md:space-y-20">
          {cs.walkthrough.items.map((item, index) => (
            <figure class:list={["grid gap-7 lg:grid-cols-[1.5fr_0.5fr] lg:items-center", index % 2 === 1 && "lg:grid-cols-[0.5fr_1.5fr]"]} data-reveal>
              <div class:list={[index % 2 === 1 && "lg:order-2"]}>
                <BrowserScreenshot image={item.image} alt={item.alt} route={item.route} />
              </div>
              <figcaption class:list={["lg:pl-3", index % 2 === 1 && "lg:order-1 lg:pl-0 lg:pr-3"]}>
                <span class="font-mono text-xs font-bold text-green">0{index + 1}</span>
                <h3 class="mt-4 text-2xl font-extrabold">{item.title}</h3>
                <p class="mt-3 font-medium leading-relaxed text-light-muted">{item.description}</p>
                <p class="mt-5 border-l-2 border-green pl-4 text-sm font-bold leading-relaxed">{item.proof}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="technical-foundation" class="grid-texture border-b border-line" aria-labelledby="technical-foundation-title">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
        <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
          <div data-reveal>
            <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{cs.foundation.eyebrow}</p>
            <h2 id="technical-foundation-title" class="mt-3 text-h2 font-bold">{cs.foundation.title}</h2>
            <p class="mt-5 font-medium leading-relaxed text-ink-muted">{cs.foundation.description}</p>
          </div>

          <ol class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2" data-reveal-group>
            {cs.foundation.items.map((item, index) => (
              <li class="bg-base p-6" data-reveal style={`--reveal-delay: ${index * 55}ms`}>
                <span class="font-mono text-[0.65rem] font-bold text-accent">0{index + 1}</span>
                <h3 class="mt-5 text-lg font-extrabold">{item.title}</h3>
                <p class="mt-2 text-sm font-medium leading-relaxed text-ink-muted">{item.description}</p>
                {"evidence" in item && item.evidence && (
                  <div class="mt-5 flex flex-wrap gap-2">
                    {item.evidence.map((evidence) => (
                      <a
                        href={`${SITE.parentOrg.url}${evidence.path}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 rounded-full border border-accent/35 px-3 py-1.5 font-mono text-[0.62rem] font-bold uppercase tracking-[0.1em] text-accent transition-colors hover:border-accent hover:bg-accent/10"
                      >
                        {evidence.label}<span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-light-base text-light-ink" aria-labelledby="delivery-title">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
        <div class="max-w-4xl" data-reveal>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-green">{cs.delivery.eyebrow}</p>
          <h2 id="delivery-title" class="mt-3 text-h2 font-bold">{cs.delivery.title}</h2>
          <p class="mt-5 max-w-3xl font-medium leading-relaxed text-light-muted">{cs.delivery.description}</p>
        </div>

        <ol class="mt-10 grid overflow-hidden rounded-3xl border border-light-line md:grid-cols-5" data-reveal-group>
          {cs.delivery.steps.map((step, index) => (
            <li class="relative border-b border-light-line p-5 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0" data-reveal style={`--reveal-delay: ${index * 65}ms`}>
              <span class="font-mono text-[0.65rem] font-bold text-green">0{index + 1}</span>
              <h3 class="mt-8 text-lg font-extrabold">{step.title}</h3>
              <p class="mt-2 text-sm font-medium leading-relaxed text-light-muted">{step.description}</p>
              {index < cs.delivery.steps.length - 1 && <span class="absolute right-4 top-4 hidden font-mono text-green md:block" aria-hidden="true">→</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="evidence" class="border-b border-line" aria-labelledby="measurement-title">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
        <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
          <div data-reveal>
            <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{cs.measurement.eyebrow}</p>
            <h2 id="measurement-title" class="mt-3 text-h2 font-bold">{cs.measurement.title}</h2>
            <p class="mt-5 font-medium leading-relaxed text-ink-muted">{cs.measurement.description}</p>
            <p class="mt-7 border-l-2 border-accent pl-4 text-sm font-bold leading-relaxed">{cs.measurement.note}</p>
          </div>

          <div>
            <dl class="grid gap-3 sm:grid-cols-3" data-reveal-group>
              {cs.measurement.baseline.map((item, index) => (
                <div class="rounded-2xl border border-line bg-surface/60 p-5" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
                  <dt class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-ink-muted">{item.label}</dt>
                  <dd class="mt-4 text-2xl font-extrabold text-accent">{item.value}</dd>
                  <p class="mt-2 text-sm font-medium leading-relaxed text-ink-muted">{item.description}</p>
                </div>
              ))}
            </dl>

            <div class="mt-3 rounded-2xl border border-accent/45 bg-accent/[0.07] p-6" data-reveal>
              <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-accent">{cs.measurement.trackLabel}</p>
              <ul class="mt-5 grid gap-4 sm:grid-cols-2">
                {cs.measurement.signals.map((signal) => (
                  <li class="flex gap-3 text-sm font-medium leading-relaxed text-ink-muted">
                    <span class="font-bold text-accent" aria-hidden="true">✓</span>
                    <span><strong class="text-ink">{signal.title}</strong><br />{signal.description}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="grid-texture border-b border-line" aria-labelledby="studio-audit-evidence-title">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
        <div class="max-w-4xl" data-reveal>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{cs.auditEvidence.eyebrow}</p>
          <h2 id="studio-audit-evidence-title" class="mt-3 text-h2 font-bold">{cs.auditEvidence.title}</h2>
          <p class="mt-5 max-w-3xl font-medium leading-relaxed text-ink-muted">{cs.auditEvidence.description}</p>
        </div>
        <div class="mt-10 grid gap-3 md:grid-cols-3" data-reveal-group>
          {cs.auditEvidence.items.map((item, index) => (
            <article class="rounded-2xl border border-line bg-surface/60 p-6" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span class="font-mono text-xs font-bold text-accent">0{index + 1}</span>
              <h3 class="mt-8 text-xl font-extrabold">{item.title}</h3>
              <p class="mt-3 text-sm font-medium leading-relaxed text-ink-muted">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section aria-labelledby="case-cta-title">
      <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 md:py-24" data-reveal>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{cs.cta.eyebrow}</p>
        <h2 id="case-cta-title" class="mt-3 text-h2 font-bold">{cs.cta.title}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg font-medium leading-relaxed text-ink-muted">{cs.cta.subtitle}</p>
        <div class="mt-8 flex justify-center">
          <Button href="/contact/">{cs.cta.button}</Button>
        </div>
      </div>
  </section>
</BaseLayout>
