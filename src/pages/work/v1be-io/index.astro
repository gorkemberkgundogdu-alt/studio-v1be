---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { useTranslations } from "@/i18n";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";

const locale = "en" as const;
const path = "/work/v1be-io/";
const t = useTranslations(locale);
const cs = t.work.caseStudy;

const crumbs = [
  { name: "Home", path: "/" },
  { name: t.nav.work, path: "/work/" },
  { name: cs.breadcrumbLabel, path },
];
---

<BaseLayout
  title={cs.meta.title}
  description={cs.meta.description}
  {locale}
  {path}
  schemas={[
    webPageSchema({ name: cs.hero.title, description: cs.meta.description, locale, path }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">{cs.hero.eyebrow}</p>
      <h1 class="mt-4 text-display font-extrabold">{cs.hero.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">{cs.hero.subtitle}</p>
    </div>
  </section>

  <section class="border-t border-line" aria-label={cs.hero.title}>
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <div class="space-y-12" data-reveal-group>
        {cs.sections.map((sec, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <h2 class="text-xl font-bold text-ink">{sec.heading}</h2>
            <p class="mt-3 leading-relaxed text-ink-muted">{sec.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="grid-texture border-t border-line">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 md:py-20">
      <h2 class="text-h2 font-bold">{cs.cta.title}</h2>
      <p class="mt-4 text-lg text-ink-muted">{cs.cta.subtitle}</p>
      <div class="mt-8 flex justify-center">
        <Button href="/contact/">{cs.cta.button}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
