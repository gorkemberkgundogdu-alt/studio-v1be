---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { useTranslations } from "@/i18n";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";

const locale = "en" as const;
const path = "/work/";
const t = useTranslations(locale);
const w = t.work;

const crumbs = [
  { name: "Home", path: "/" },
  { name: t.nav.work, path },
];
---

<BaseLayout
  title={w.meta.title}
  description={w.meta.description}
  {locale}
  {path}
  schemas={[
    webPageSchema({ name: w.hero.title, description: w.meta.description, locale, path }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">{w.hero.eyebrow}</p>
      <h1 class="mt-4 text-display font-extrabold">{w.hero.title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">{w.hero.subtitle}</p>
    </div>
  </section>

  <section class="border-t border-line" aria-label={w.hero.title}>
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <div class="grid gap-6 md:grid-cols-2" data-reveal-group>
        {w.cases.map((c) => (
          <article class="flex flex-col rounded-2xl border border-line bg-surface p-8" data-reveal>
            <span class="font-mono text-xs uppercase tracking-widest text-accent">{c.tag}</span>
            <h2 class="mt-3 text-2xl font-bold text-ink">{c.name}</h2>
            <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-muted">{c.description}</p>
            <a
              href={c.href}
              class="mt-6 inline-flex items-center gap-1 font-semibold text-accent underline decoration-transparent underline-offset-4 transition hover:decoration-accent"
            >
              {c.linkLabel} →
            </a>
          </article>
        ))}

        <article
          class="flex flex-col justify-between rounded-2xl border border-dashed border-line p-8"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          <p class="text-lg font-medium leading-relaxed text-ink-muted">{w.openSlot.label}</p>
          <div class="mt-6">
            <Button href="/contact/" variant="ghost">{w.openSlot.cta}</Button>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
