---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { useTranslations } from "@/i18n";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";

const locale = "en" as const;
const path = "/process/";
const t = useTranslations(locale);
const pr = t.process;

const crumbs = [
  { name: "Home", path: "/" },
  { name: t.nav.process, path },
];
---

<BaseLayout
  title={pr.meta.title}
  description={pr.meta.description}
  {locale}
  {path}
  schemas={[
    webPageSchema({ name: pr.hero.title, description: pr.meta.description, locale, path }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">{pr.hero.eyebrow}</p>
      <h1 class="mt-4 text-display font-extrabold">{pr.hero.title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">{pr.hero.subtitle}</p>
    </div>
  </section>

  <section class="border-t border-line" aria-label={pr.hero.title}>
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 md:py-20">
      <ol class="space-y-12" data-reveal-group>
        {pr.steps.map((step, i) => (
          <li class="grid gap-5 sm:grid-cols-[auto_1fr]" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="font-mono text-4xl font-bold text-accent" aria-hidden="true">{step.number}</span>
            <div class="border-l border-line pl-6">
              <h2 class="text-2xl font-bold text-ink">{step.title}</h2>
              <p class="mt-3 leading-relaxed text-ink-muted">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="grid-texture border-t border-line">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 md:py-20">
      <h2 class="text-h2 font-bold">{pr.cta.title}</h2>
      <p class="mt-4 text-lg text-ink-muted">{pr.cta.subtitle}</p>
      <div class="mt-8 flex justify-center">
        <Button href="/contact/">{pr.cta.button}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
