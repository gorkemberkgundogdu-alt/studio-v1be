---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CheckList from "@/components/CheckList.astro";
import CollaborationIcon from "@/components/CollaborationIcon.astro";
import ProcessArtifact from "@/components/ProcessArtifact.astro";
import ProcessStageIcon from "@/components/ProcessStageIcon.astro";
import RobotMascot from "@/components/sections/RobotMascot.astro";
import { useTranslations } from "@/i18n";
import { breadcrumbSchema, webPageSchema } from "@/config/schemas";
import { isCollaborationAgreementId, isCollaborationRhythmId } from "@/types/collaboration";
import { isProcessStageId } from "@/types/process";

const locale = (Astro.props.locale ?? "en") as import("@/i18n").Locale;
const path = "/process/";
const t = useTranslations(locale);
const pr = t.process;
const processSteps = pr.steps.map((step) => {
  if (!isProcessStageId(step.id)) throw new Error(`Unknown process stage: ${step.id}`);
  return { ...step, id: step.id };
});
const compactStageNote = (section: { body: string; items: readonly string[] }) => {
  if (section.items[0]) return section.items[0];
  return section.body.split(/(?<=[.!?])\s+/)[0] ?? "";
};
const collaborationRhythm = pr.collaboration.rhythm.map((item) => {
  if (!isCollaborationRhythmId(item.id)) throw new Error(`Unknown collaboration rhythm: ${item.id}`);
  return { ...item, id: item.id };
});
const collaborationPrinciples = pr.collaboration.principles.map((item) => {
  if (!isCollaborationAgreementId(item.id)) throw new Error(`Unknown collaboration agreement: ${item.id}`);
  return { ...item, id: item.id };
});

const crumbs = [
  { name: "Home", path: "/" },
  { name: t.nav.process, path },
];
---

<BaseLayout
  title={pr.meta.title}
  description={pr.meta.description}
  {locale}
  {path}
  schemas={[
    webPageSchema({ name: pr.hero.title, description: pr.meta.description, locale, path }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture overflow-hidden">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 md:py-14 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div data-reveal-group>
        <p class="font-mono text-sm font-semibold uppercase tracking-widest text-accent" data-reveal>{pr.hero.eyebrow}</p>
        <h1
          class="mt-4 max-w-4xl font-extrabold"
          style="font-size: clamp(1.75rem, 1.2rem + 3.2vw, 3.5rem); line-height: 1.05; letter-spacing: -0.03em;"
          data-reveal
        >
          {pr.hero.title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-muted" data-reveal>{pr.hero.subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          <Button href="/contact/" data-cta="process_hero_audit">{pr.hero.primaryCta}</Button>
          <Button href="#process-stages" variant="surface">{pr.hero.secondaryCta}</Button>
        </div>
      </div>

      <div class="mx-auto w-[160px] shrink-0 md:w-[200px]" data-reveal>
        <RobotMascot look="classic" />
      </div>
    </div>
  </section>

  <nav class="border-y border-line bg-surface/45" aria-label={pr.overview.label}>
    <div class="mx-auto grid max-w-6xl gap-4 px-4 py-4 sm:px-6 lg:grid-cols-[11rem_minmax(0,1fr)] lg:items-center lg:gap-6">
      <p class="font-mono text-sm font-bold uppercase tracking-widest text-ink">{pr.overview.label}</p>
      <ol class="grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2 md:grid-cols-4" role="list">
        {processSteps.map((step, index) => (
          <li class="min-w-0">
            <a class="group grid grid-cols-[1.5rem_minmax(0,1fr)] items-center gap-2 py-1 text-[0.8125rem] motion-safe:transition-colors hover:text-accent" href={`#process-${step.id}`}>
              <span class="flex flex-col items-center gap-1.5">
                <span class="font-mono text-xs font-bold text-accent">{step.number}</span>
                <span class="grid size-6 place-items-center rounded-md border border-line text-ink-muted group-hover:border-accent/45 group-hover:text-accent">
                  <ProcessStageIcon kind={step.id} />
                </span>
              </span>
              <span class="flex min-w-0 flex-col leading-tight">
                <strong class="min-[1100px]:whitespace-nowrap">{step.label}</strong>
                <small class="mt-1 text-[0.65rem] font-normal text-ink-muted">{pr.overview.stageStatus[index]}</small>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <section class="border-y border-light-line bg-light-base text-light-ink" aria-labelledby="starting-point-title">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28" data-reveal-group>
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.72fr)_minmax(34rem,1.28fr)] lg:items-end">
        <div>
          <p class="font-mono text-sm font-semibold uppercase tracking-widest text-green" data-reveal>{pr.startingPoint.eyebrow}</p>
          <h2 id="starting-point-title" class="mt-5 max-w-4xl text-h2 font-black" data-reveal>{pr.startingPoint.title}</h2>
        </div>
        <p class="max-w-3xl text-lg leading-relaxed text-light-muted lg:pb-1" data-reveal>{pr.startingPoint.intro}</p>
      </div>

      <div class="process-convergence mt-12 overflow-hidden rounded-[1.75rem] border border-light-line bg-white/45" data-process-convergence data-active-path="0" data-reveal>
        <div class="flex items-center justify-between gap-4 border-b border-light-line px-5 py-4 sm:px-7">
          <p class="font-mono text-[0.6875rem] font-black uppercase tracking-[0.18em] text-green">{pr.startingPoint.flow.modelLabel}</p>
          <p class="hidden font-mono text-[0.625rem] font-semibold uppercase tracking-wider text-light-muted sm:block">{pr.startingPoint.flow.selectLabel}</p>
        </div>

        <div class="grid gap-8 p-5 sm:p-7 lg:grid-cols-[minmax(15rem,0.78fr)_minmax(25rem,1.22fr)] lg:items-center lg:gap-10 lg:p-9">
          <div class="grid gap-3" role="group" aria-label={pr.startingPoint.flow.choiceLabel}>
            {pr.startingPoint.paths.map((entry, index) => (
              <button
                class="process-entry group relative overflow-hidden rounded-2xl border border-light-line bg-light-base p-5 text-left motion-safe:transition-transform motion-safe:duration-300 hover:-translate-y-0.5 hover:border-green/50"
                type="button"
                data-process-entry={index}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="absolute inset-y-0 left-0 w-1 origin-bottom scale-y-0 bg-green motion-safe:transition-transform motion-safe:duration-300" aria-hidden="true"></span>
                <span class="font-mono text-[0.6875rem] font-black text-green">0{index + 1}</span>
                <span class="mt-2 block text-xl font-extrabold">{entry.title}</span>
                <span class="mt-2 block text-sm leading-relaxed text-light-muted">{entry.description}</span>
              </button>
            ))}
          </div>

          <div class="relative min-h-[24rem] rounded-2xl border border-light-line bg-light-base/70 p-5 sm:min-h-[21rem] sm:p-7" aria-label={pr.startingPoint.convergence}>
            <div class="process-grid absolute inset-0 rounded-2xl" aria-hidden="true"></div>
            <svg class="absolute inset-0 size-full" viewBox="0 0 720 336" preserveAspectRatio="none" aria-hidden="true">
              <path class="process-route process-route--zero" d="M 18 76 C 132 76, 118 168, 236 168" pathLength="1"></path>
              <path class="process-route process-route--live" d="M 18 260 C 132 260, 118 168, 236 168" pathLength="1"></path>
              <path class="process-route process-route--shared" d="M 236 168 C 302 168, 304 168, 360 168" pathLength="1"></path>
              <path class="process-route process-route--shared" d="M 436 168 C 486 168, 486 59, 520 59 L 548 59" pathLength="1"></path>
              <path class="process-route process-route--shared" d="M 520 59 L 520 277" pathLength="1"></path>
              <path class="process-route process-route--shared" d="M 520 132 L 548 132 M 520 204 L 548 204 M 520 277 L 548 277" pathLength="1"></path>
            </svg>

            <div class="absolute left-[4%] top-[13%] flex items-center gap-2 text-green" aria-hidden="true">
              <span class="size-2.5 rounded-full border-2 border-green bg-light-base"></span>
              <span class="font-mono text-[0.6rem] font-black uppercase tracking-wider">{pr.startingPoint.flow.opportunityLabel}</span>
            </div>
            <div class="absolute bottom-[13%] left-[4%] flex items-center gap-2 text-green" aria-hidden="true">
              <span class="size-2.5 rounded-full border-2 border-green bg-light-base"></span>
              <span class="font-mono text-[0.6rem] font-black uppercase tracking-wider">{pr.startingPoint.flow.evidenceLabel}</span>
            </div>

            <div class="absolute left-[34%] top-1/2 z-10 w-28 -translate-x-1/2 -translate-y-1/2 rounded-2xl border border-green bg-light-base px-3 py-5 text-center shadow-[0_14px_40px_rgba(18,18,20,0.08)] sm:left-[40%] sm:w-[8.5rem] sm:px-4 lg:left-[43%]">
              <span class="mx-auto grid size-8 place-items-center rounded-full bg-green font-mono text-xs font-black text-cream">→</span>
              <strong class="mt-3 block text-sm font-black">{pr.startingPoint.flow.convergenceTitle}</strong>
              <small class="mt-1 block text-[0.625rem] font-semibold uppercase tracking-wider text-light-muted">{pr.startingPoint.flow.convergenceStatus}</small>
            </div>

            <ol class="absolute bottom-[8%] right-[2%] top-[8%] z-10 grid w-[45%] grid-rows-4 gap-2 sm:right-[3%] sm:w-[35%] lg:w-[30%]" role="list" aria-label={pr.startingPoint.flow.stagesLabel}>
              {processSteps.map((step) => (
                <li class="flex items-center gap-2 rounded-xl border border-light-line bg-light-base px-2.5 py-2 shadow-[0_8px_24px_rgba(18,18,20,0.05)]">
                  <span class="grid size-7 shrink-0 place-items-center rounded-lg bg-green text-cream">
                    <ProcessStageIcon kind={step.id} />
                  </span>
                  <span class="min-w-0">
                    <span class="block font-mono text-[0.5625rem] font-black text-green">{step.number}</span>
                    <strong class="block text-[0.625rem] font-extrabold leading-tight sm:text-[0.6875rem]">{step.label}</strong>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="grid gap-3 border-t border-light-line px-5 py-4 sm:grid-cols-[1fr_auto] sm:items-center sm:px-7">
          <p class="font-mono text-xs font-bold uppercase tracking-wider text-green">{pr.startingPoint.convergence}</p>
          <p class="font-mono text-[0.625rem] uppercase tracking-wider text-light-muted">{processSteps.map((step) => step.label).join(" → ")}</p>
        </div>
      </div>
    </div>
  </section>

  <div id="process-stages" class="grid-texture scroll-mt-16" aria-label={pr.hero.title} data-process-deck>
    <div
      class="process-stage-track"
      data-process-track
      style={`--process-stage-count: ${processSteps.length};`}
    >
    <div class="process-stage-viewport mx-auto grid max-w-7xl gap-10 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-[11rem_minmax(0,1fr)]" data-process-viewport>
      <nav class="process-stage-nav relative grid grid-cols-2 gap-2 self-start lg:sticky lg:top-24 lg:grid-cols-1" aria-label="Process stages" data-process-nav>
        <span class="absolute -left-3 top-3 bottom-3 hidden w-px bg-line lg:block" aria-hidden="true"></span>
        <span class="absolute -left-3 bottom-3 top-3 hidden w-px origin-top scale-y-0 bg-accent motion-safe:transition-transform motion-safe:duration-300 lg:block" aria-hidden="true" data-process-progress></span>
        {processSteps.map((step, index) => (
          <a
            class="process-stage-link group grid grid-cols-[2rem_1fr] items-center gap-2 rounded-xl border border-line bg-surface/45 px-3 py-3 text-sm text-ink-muted motion-safe:transition-colors hover:border-accent/40 hover:text-ink"
            href={`#process-${step.id}`}
            data-process-stage-link={step.id}
            aria-current={index === 0 ? "step" : undefined}
          >
            <span class="font-mono text-xs font-bold text-accent">{step.number}</span>
            <span class="font-semibold">{step.label}</span>
          </a>
        ))}
      </nav>

      <ol class="process-stage-list" role="list" data-process-stage-list>
        {processSteps.map((step) => (
          <li class="process-stage-item border-b border-line py-20 first:pt-0 last:border-b-0 last:pb-0" data-process-stage-item={step.id}>
            <section id={`process-${step.id}`} class="process-stage-panel grid scroll-mt-24 gap-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(20rem,0.92fr)] lg:gap-10" data-reveal-contained data-reveal-group>
              <div class="process-stage-copy">
                <p class="font-mono text-sm font-semibold uppercase tracking-widest text-accent" data-reveal>{step.number} · {step.label}</p>
                <h2 class="process-stage-title mt-4 text-h2 font-black" data-reveal>{step.title}</h2>
                <p class="process-stage-intro mt-5 text-lg leading-relaxed text-ink-muted" data-reveal>{step.intro}</p>

                {step.description && (
                  step.id === "validate" ? (
                    <blockquote class="mt-7 border-l-2 border-accent bg-surface/60 px-5 py-4 text-xl font-extrabold" data-reveal>{step.description}</blockquote>
                  ) : (
                    <p class="mt-5 leading-relaxed text-ink-muted" data-reveal>{step.description}</p>
                  )
                )}

                <ul class="process-stage-summary" role="list" hidden data-process-stage-summary>
                  {step.sections.map((section, sectionIndex) => (
                    <li>
                      <h3>{section.title}</h3>
                      <p>{compactStageNote(section)}</p>
                      {step.gates
                        .filter((gate) => gate.afterSection === sectionIndex)
                        .map((gate) => <span>{gate.label}</span>)}
                    </li>
                  ))}
                </ul>

                <div
                  class="process-stage-sections mt-9 grid gap-7"
                  data-reveal-group
                  style={`--process-detail-count: ${step.sections.length};`}
                >
                  {step.sections.map((section, sectionIndex) => (
                    <div class="process-stage-detail-group" data-reveal style={`--reveal-delay: ${Math.min(sectionIndex * 60, 180)}ms`}>
                      <section class="process-stage-detail" data-reveal-contained>
                        <h3 class="text-lg font-extrabold">{section.title}</h3>
                        {section.body && <p class="mt-3 text-sm leading-relaxed text-ink-muted">{section.body}</p>}
                        {step.id === "design" && sectionIndex < 2 && (
                          <p class="mt-4 font-mono text-xs font-semibold uppercase tracking-wider text-accent">{pr.designReviewLabel}</p>
                        )}
                        {section.items.length > 0 && <CheckList items={section.items} class="process-stage-checklist mt-4 gap-2.5" itemClass="process-stage-check text-sm" />}
                      </section>
                      {step.gates
                        .filter((gate) => gate.afterSection === sectionIndex)
                        .map((gate) => (
                          <div class="process-stage-gate rounded-xl border border-accent/30 bg-accent/5 p-5">
                            <p class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">{gate.label}</p>
                            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{gate.description}</p>
                          </div>
                        ))}
                    </div>
                  ))}
                </div>

                <p class="mt-9 border-l-2 border-accent pl-5 font-semibold leading-relaxed text-ink" data-reveal>{step.outcome}</p>
              </div>

              <div class="process-stage-artifact lg:sticky lg:top-24 lg:self-start" data-reveal>
                <ProcessArtifact kind={step.id} {...step.artifact} />
              </div>
            </section>
          </li>
        ))}
      </ol>
    </div>
    </div>
  </div>

  <section class="border-y border-light-line bg-light-base text-light-ink" aria-labelledby="collaboration-title">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28" data-reveal-group>
      <p class="font-mono text-sm font-semibold uppercase tracking-widest text-green" data-reveal>{pr.collaboration.eyebrow}</p>
      <h2 id="collaboration-title" class="mt-5 max-w-4xl text-h2 font-black" data-reveal>{pr.collaboration.title}</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-light-muted" data-reveal>{pr.collaboration.intro}</p>

      <div class="relative mt-12 pt-5" data-reveal-group>
        <span class="absolute bottom-5 left-5 top-5 w-px bg-green/45 lg:hidden" aria-hidden="true"></span>
        <span class="absolute left-[10%] right-[10%] top-5 hidden h-px bg-green/45 lg:block" aria-hidden="true"></span>
        <ol class="relative grid gap-5 lg:grid-cols-5" role="list">
          {collaborationRhythm.map((item, index) => (
            <li
              class:list={[
                "relative ml-12 flex flex-col rounded-[1.25rem] border px-5 pb-5 pt-8 text-center lg:ml-0 lg:min-h-64 lg:pt-10",
                item.id === "delivery" ? "border-green/45 bg-green/8" : "border-light-line bg-white/35",
              ]}
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <span
                class:list={[
                  "absolute -left-12 top-5 grid size-10 place-items-center rounded-full border border-green font-mono text-xs font-black lg:-top-5 lg:left-1/2 lg:-translate-x-1/2",
                  item.id === "delivery" ? "bg-green text-light-ink" : "bg-light-base text-green",
                ]}
                aria-hidden="true"
              >
                0{index + 1}
              </span>
              <span class="mx-auto grid size-12 place-items-center rounded-full bg-green/8 text-green" aria-hidden="true">
                <CollaborationIcon kind={item.id} />
              </span>
              {item.id === "delivery" && <p class="mt-3 font-mono text-[0.65rem] font-bold uppercase tracking-wider text-green">{pr.collaboration.outcomeLabel}</p>}
              <h3 class="mt-4 text-lg font-extrabold text-light-ink">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-light-muted">{item.description}</p>
              <p class="mt-auto pt-5 font-mono text-sm font-bold text-green">{item.signal}</p>
            </li>
          ))}
        </ol>

        <div class="relative mx-[10%] hidden h-16 items-end justify-center rounded-b-2xl border-b border-l border-r border-dashed border-green/45 lg:flex" aria-hidden="true">
          <span class="absolute -left-1 -top-2 font-mono text-green">↑</span>
          <span class="absolute -right-1 -top-2 font-mono text-green">↑</span>
          <span class="translate-y-1/2 rounded-full border border-light-line bg-light-base px-5 py-2 font-mono text-xs font-bold text-green">
            ↻ {pr.collaboration.loopLabel}
          </span>
        </div>
        <p class="ml-12 mt-5 w-fit rounded-full border border-light-line bg-white/35 px-4 py-2 font-mono text-xs font-bold text-green lg:hidden">
          ↻ {pr.collaboration.loopLabel}
        </p>
      </div>

      <div class="mt-12 border-t border-light-line pt-8" data-reveal>
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <p class="font-mono text-xs font-semibold uppercase tracking-wider text-green">{pr.collaboration.principlesLabel}</p>
          <p class="font-mono text-xs font-semibold uppercase tracking-wider text-green lg:text-right">{pr.collaboration.closing}</p>
        </div>
        <ul class="mt-5 grid gap-3 md:grid-cols-3" role="list">
          {collaborationPrinciples.map((principle, index) => (
            <li class="grid grid-cols-[2.25rem_minmax(0,1fr)_2rem] items-center gap-4 rounded-xl border border-light-line bg-white/35 p-5 text-sm font-semibold leading-relaxed text-light-ink">
              <span class="grid size-9 place-items-center rounded-full bg-green/10 font-mono text-xs font-black text-green" aria-hidden="true">0{index + 1}</span>
              <span class="border-l border-light-line pl-4">{principle.text}</span>
              <CollaborationIcon kind={principle.id} class="text-green" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-labelledby="after-launch-title">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28" data-reveal-group>
      <p class="font-mono text-sm font-semibold uppercase tracking-widest text-accent" data-reveal>{pr.afterLaunch.eyebrow}</p>
      <h2 id="after-launch-title" class="mt-5 max-w-4xl text-h2 font-black" data-reveal>{pr.afterLaunch.title}</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-muted" data-reveal>{pr.afterLaunch.intro}</p>

      <div class="mt-10 grid gap-5 lg:grid-cols-2" data-reveal-group>
        <article class="rounded-[1.4rem] border border-line bg-surface p-7 sm:p-8" data-reveal>
          <h3 class="text-xl font-extrabold">{pr.afterLaunch.includedTitle}</h3>
          <CheckList items={pr.afterLaunch.included} class="mt-5" />
        </article>

        <article class="rounded-[1.4rem] border border-accent/35 bg-accent/5 p-7 sm:p-8" data-reveal style="--reveal-delay: 70ms">
          <h3 class="text-xl font-extrabold">{pr.afterLaunch.growTitle}</h3>
          <p class="mt-5 text-sm leading-relaxed text-ink-muted">{pr.afterLaunch.growDescription}</p>
          <p class="mt-5 text-sm font-semibold leading-relaxed text-ink">{pr.afterLaunch.ownership}</p>
        </article>
      </div>

      <p class="mt-6 rounded-xl border border-line bg-base/65 p-5 font-mono text-xs font-semibold uppercase tracking-wider text-accent" data-reveal>{pr.afterLaunch.boundary}</p>
    </div>
  </section>

  <section class="grid-texture border-t border-line" aria-labelledby="process-cta-title">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 md:py-28" data-reveal-group>
      <p class="font-mono text-sm font-semibold uppercase tracking-widest text-accent" data-reveal>{pr.cta.eyebrow}</p>
      <h2 id="process-cta-title" class="mt-5 text-h2 font-black" data-reveal>{pr.cta.title}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted" data-reveal>{pr.cta.subtitle}</p>
      <div class="mt-8 flex justify-center" data-reveal>
        <Button href="/contact/" data-cta="process_final_audit">{pr.cta.button}</Button>
      </div>
      <p class="mt-5 font-mono text-xs uppercase tracking-wider text-ink-muted" data-reveal>{pr.cta.note}</p>
    </div>
  </section>
</BaseLayout>

<script>
  const convergence = document.querySelector<HTMLElement>("[data-process-convergence]");

  if (convergence) {
    const entries = Array.from(convergence.querySelectorAll<HTMLButtonElement>("[data-process-entry]"));

    const setActivePath = (index: number) => {
      convergence.dataset.activePath = String(index);
      entries.forEach((entry, entryIndex) => entry.setAttribute("aria-pressed", String(entryIndex === index)));
    };

    entries.forEach((entry, index) => entry.addEventListener("click", () => setActivePath(index)));
  }

  const processDeck = document.querySelector<HTMLElement>("[data-process-deck]");
  const processNav = processDeck?.querySelector<HTMLElement>("[data-process-nav]");
  const processTrack = processDeck?.querySelector<HTMLElement>("[data-process-track]");
  const processViewport = processDeck?.querySelector<HTMLElement>("[data-process-viewport]");

  if (processDeck && processNav && processTrack && processViewport) {
    const links = Array.from(processNav.querySelectorAll<HTMLAnchorElement>("[data-process-stage-link]"));
    const progress = processNav.querySelector<HTMLElement>("[data-process-progress]");
    const stages = links
      .map((link) => {
        const id = link.dataset.processStageLink;
        const section = id ? document.getElementById(`process-${id}`) : null;
        const item = id
          ? processDeck.querySelector<HTMLElement>(`[data-process-stage-item="${id}"]`)
          : null;
        return id && section && item ? { id, link, section, item } : null;
      })
      .filter(
        (stage): stage is { id: string; link: HTMLAnchorElement; section: HTMLElement; item: HTMLElement } =>
          stage !== null,
      );
    const stageSummaries = Array.from(processDeck.querySelectorAll<HTMLElement>("[data-process-stage-summary]"));
    const stageDetails = Array.from(processDeck.querySelectorAll<HTMLElement>(".process-stage-sections"));

    const deckQuery = window.matchMedia(
      "(min-width: 1280px) and (min-height: 700px) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
    );
    let activeIndex = Math.max(
      0,
      stages.findIndex((stage) => window.location.hash === `#process-${stage.id}`),
    );
    let transitionTimer = 0;
    let scrollLocked = false;
    let wheelDelta = 0;
    let scrollFrame = 0;
    let scrollLockTimer = 0;
    let hashAlignmentTimer = 0;
    let deckAbort: AbortController | null = null;
    let naturalAbort: AbortController | null = null;
    let naturalObserver: IntersectionObserver | null = null;

    const setCompactStageContent = (enabled: boolean) => {
      stageSummaries.forEach((summary) => { summary.hidden = !enabled; });
      stageDetails.forEach((details) => { details.hidden = enabled; });
    };

    const updateNavigation = () => {
      stages.forEach((stage, index) => {
        if (index === activeIndex) stage.link.setAttribute("aria-current", "step");
        else stage.link.removeAttribute("aria-current");
      });

      if (progress) {
        const progressValue = stages.length > 1 ? activeIndex / (stages.length - 1) : 1;
        progress.style.transform = `scaleY(${progressValue})`;
      }
    };

    const activateStage = (nextIndex: number, animate = true) => {
      const clampedIndex = Math.min(Math.max(nextIndex, 0), stages.length - 1);
      if (clampedIndex === activeIndex && stages[clampedIndex]?.item.classList.contains("is-active")) return;

      const previousIndex = activeIndex;
      const direction = clampedIndex >= previousIndex ? 1 : -1;
      const previous = stages[previousIndex]?.item;
      const incoming = stages[clampedIndex]?.item;
      if (!incoming) return;

      window.clearTimeout(transitionTimer);
      stages.forEach((stage, index) => {
        stage.item.inert = index !== clampedIndex;
        stage.item.setAttribute("aria-hidden", String(index !== clampedIndex));
        stage.item.classList.remove(
          "is-active",
          "is-entering-from-above",
          "is-entering-from-below",
          "is-leaving-to-above",
          "is-leaving-to-below",
        );
      });

      if (animate && previous && previous !== incoming) {
        previous.classList.add(direction > 0 ? "is-leaving-to-above" : "is-leaving-to-below");
        incoming.classList.add(direction > 0 ? "is-entering-from-below" : "is-entering-from-above");
        void incoming.offsetHeight;
      }

      activeIndex = clampedIndex;
      incoming.classList.add("is-active");
      incoming.classList.remove("is-entering-from-above", "is-entering-from-below");
      updateNavigation();

      transitionTimer = window.setTimeout(() => {
        stages.forEach((stage) => stage.item.classList.remove("is-leaving-to-above", "is-leaving-to-below"));
      }, 520);
    };

    const resetStagePresentation = () => {
      window.clearTimeout(transitionTimer);
      window.clearTimeout(scrollLockTimer);
      window.clearTimeout(hashAlignmentTimer);
      if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      scrollLocked = false;
      wheelDelta = 0;
      processDeck.classList.remove("is-process-deck");
      setCompactStageContent(false);
      stages.forEach((stage) => {
        stage.item.inert = false;
        stage.item.removeAttribute("aria-hidden");
        stage.item.classList.remove(
          "is-active",
          "is-entering-from-above",
          "is-entering-from-below",
          "is-leaving-to-above",
          "is-leaving-to-below",
        );
      });
    };

    const stopCurrentMode = () => {
      deckAbort?.abort();
      naturalAbort?.abort();
      naturalObserver?.disconnect();
      deckAbort = null;
      naturalAbort = null;
      naturalObserver = null;
      resetStagePresentation();
    };

    const setupDeckMode = () => {
      if (stages.length === 0) return;
      const controller = new AbortController();
      deckAbort = controller;
      processDeck.classList.add("is-process-deck");
      setCompactStageContent(true);
      processDeck.querySelectorAll<HTMLElement>("[data-reveal]").forEach((element) => element.classList.add("is-revealed"));
      activateStage(activeIndex, false);

      const stickyTop = 64;
      const scrollMetrics = () => {
        const start = processTrack.getBoundingClientRect().top + window.scrollY - stickyTop;
        const end = start + processTrack.offsetHeight - processViewport.offsetHeight;
        return { start, step: Math.max((end - start) / Math.max(stages.length - 1, 1), 1) };
      };

      const isDeckPinned = () => {
        const rect = processViewport.getBoundingClientRect();
        return rect.top <= stickyTop + 2 && rect.bottom >= window.innerHeight - 2;
      };

      const scrollToStage = (index: number, updateHash = true) => {
        const nextIndex = Math.min(Math.max(index, 0), stages.length - 1);
        const { start, step } = scrollMetrics();
        scrollLocked = true;
        wheelDelta = 0;
        activateStage(nextIndex);
        window.scrollTo({ top: start + step * nextIndex, behavior: "smooth" });
        if (updateHash) history.replaceState(null, "", `#process-${stages[nextIndex].id}`);
        window.clearTimeout(scrollLockTimer);
        scrollLockTimer = window.setTimeout(() => {
          scrollLocked = false;
        }, 620);
      };

      const stageAnchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[href^="#process-"]'));
      stageAnchors.forEach((anchor) => {
        anchor.addEventListener("click", (event) => {
          const id = anchor.hash.replace("#process-", "");
          const nextIndex = stages.findIndex((stage) => stage.id === id);
          if (nextIndex < 0) return;
          event.preventDefault();
          scrollToStage(nextIndex);
        }, { signal: controller.signal });
      });

      window.addEventListener(
        "wheel",
        (event) => {
          if (!isDeckPinned() || document.documentElement.classList.contains("nav-overlay-open")) return;
          const direction = Math.sign(event.deltaY);
          if (direction === 0) return;
          if (scrollLocked) {
            event.preventDefault();
            return;
          }
          if ((activeIndex === 0 && direction < 0) || (activeIndex === stages.length - 1 && direction > 0)) return;

          event.preventDefault();
          wheelDelta += event.deltaY;
          if (Math.abs(wheelDelta) < 24) return;
          scrollToStage(activeIndex + (wheelDelta > 0 ? 1 : -1));
        },
        { passive: false, signal: controller.signal },
      );

      window.addEventListener("keydown", (event) => {
        if (!isDeckPinned() || document.documentElement.classList.contains("nav-overlay-open")) return;
        if (event.target instanceof HTMLElement && event.target.matches("input, textarea, select, button")) return;
        const direction = event.key === "ArrowDown" || event.key === "PageDown" ? 1 : event.key === "ArrowUp" || event.key === "PageUp" ? -1 : 0;
        if (direction === 0) return;
        if (scrollLocked) {
          event.preventDefault();
          return;
        }
        if ((activeIndex === 0 && direction < 0) || (activeIndex === stages.length - 1 && direction > 0)) return;
        event.preventDefault();
        scrollToStage(activeIndex + direction);
      }, { signal: controller.signal });

      window.addEventListener(
        "scroll",
        () => {
          if (scrollLocked || scrollFrame) return;
          scrollFrame = window.requestAnimationFrame(() => {
            scrollFrame = 0;
            const { start, step } = scrollMetrics();
            const nextIndex = Math.min(Math.max(Math.round((window.scrollY - start) / step), 0), stages.length - 1);
            if (isDeckPinned() && nextIndex !== activeIndex) activateStage(nextIndex);
          });
        },
        { passive: true, signal: controller.signal },
      );

      if (window.location.hash.startsWith("#process-")) {
        const alignHashStage = () => {
          window.clearTimeout(hashAlignmentTimer);
          hashAlignmentTimer = window.setTimeout(() => {
            if (!controller.signal.aborted && deckQuery.matches) scrollToStage(activeIndex, false);
          }, 50);
        };
        if (document.readyState === "complete") alignHashStage();
        else window.addEventListener("load", alignHashStage, { once: true, signal: controller.signal });
      }
    };

    const setupNaturalMode = () => {
      const controller = new AbortController();
      naturalAbort = controller;
      const setActiveStage = (id: string) => {
        const nextIndex = stages.findIndex((stage) => stage.id === id);
        if (nextIndex < 0) return;
        activeIndex = nextIndex;
        updateNavigation();
      };

      updateNavigation();
      naturalObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => Math.abs(a.boundingClientRect.top - window.innerHeight * 0.3) - Math.abs(b.boundingClientRect.top - window.innerHeight * 0.3));
          const current = visible[0]?.target as HTMLElement | undefined;
          if (current?.id) setActiveStage(current.id.replace("process-", ""));
        },
        { rootMargin: "-20% 0px -65% 0px", threshold: 0 },
      );

      stages.forEach((stage) => naturalObserver?.observe(stage.section));
      window.addEventListener("hashchange", () => setActiveStage(window.location.hash.replace("#process-", "")), { signal: controller.signal });
    };

    const syncStageMode = () => {
      stopCurrentMode();
      if (deckQuery.matches && document.documentElement.classList.contains("js-anim")) setupDeckMode();
      else setupNaturalMode();
    };

    syncStageMode();
    deckQuery.addEventListener("change", syncStageMode);
  }
</script>

