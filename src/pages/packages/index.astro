---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import RobotMascot from "@/components/sections/RobotMascot.astro";
import ServiceNeedsConfigurator from "@/components/packages/ServiceNeedsConfigurator.astro";
import DeliverableProofRail from "@/components/packages/DeliverableProofRail.astro";
import { useTranslations } from "@/i18n";
import { serviceSchema, faqSchema, breadcrumbSchema } from "@/config/schemas";

const locale = "en" as const;
const path = "/packages/";
const t = useTranslations(locale);
const p = t.packages;

const crumbs = [
  { name: "Home", path: "/" },
  { name: t.nav.packages, path },
];

// Her yol için Service JSON-LD — görünür kopyayla aynı kaynaktan (schemaSummary
// yalnızca şemaya girer, kartta ayrıca render edilmez).
const services = p.paths.map((item) =>
  serviceSchema({ name: item.title, description: item.schemaSummary, locale, path }),
);

const configuratorPaths = p.paths.map((item) => ({
  id: item.id,
  label: item.microLabel,
  title: item.title,
  description: item.selectorDescription,
  price: `From ${item.priceNew}`,
  bullets: item.bullets,
  cta: item.briefCta,
}));
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  {locale}
  {path}
  schemas={[...services, faqSchema(p.faq.items), breadcrumbSchema(crumbs, locale)]}
>
  <Breadcrumb {locale} items={crumbs} />

  {/* 1 — Hero: metin sol/orta, mascot sağda (Home'un tam ortalanmış hero'sundan
      bilinçli fark — burada tek bir yerleşik poz, blueprint look yok çünkü
      kodda mevcut değil, CLAUDE.md §7 gereği main site ile aynı "classic"). */}
  <section class="grid-texture">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-[1.3fr_auto]" data-reveal-group>
        <div>
          <p class="font-mono text-sm font-semibold uppercase tracking-widest text-accent" data-reveal>{p.hero.eyebrow}</p>
          <h1
            class="mt-4 font-extrabold"
            style="font-size: clamp(1.75rem, 1.2rem + 3.2vw, 3.5rem); line-height: 1.05; letter-spacing: -0.03em;"
            data-reveal
          >
            {p.hero.title}
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted" data-reveal>{p.hero.subtitle}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal>
            <Button href="/contact/" data-cta="packages_hero_audit">{p.hero.primaryCta}</Button>
            <Button href="#scope-builder" variant="ghost" data-cta="packages_hero_brief">{p.hero.secondaryCta}</Button>
          </div>
          <p class="mt-4 font-mono text-xs uppercase tracking-wider text-ink-muted" data-reveal>{p.hero.reassurance}</p>
        </div>
        <div class="mx-auto w-[160px] shrink-0 md:w-[200px]" data-reveal>
          <RobotMascot look="classic" />
        </div>
      </div>
    </div>
  </section>

  <ServiceNeedsConfigurator
    eyebrow={p.configurator.eyebrow}
    title={p.configurator.title}
    intro={p.configurator.intro}
    pathQuestion={p.configurator.pathQuestion}
    pathOptions={configuratorPaths}
    needsQuestion={p.configurator.needsQuestion}
    needsNote={p.configurator.needsNote}
    needOptions={p.configurator.needs}
    layers={p.configurator.layers}
    summary={p.configurator.summary}
  />

  <DeliverableProofRail
    eyebrow={p.proof.eyebrow}
    title={p.proof.title}
    intro={p.proof.intro}
    items={p.proof.items}
    cta={p.proof.cta}
    ctaHref={p.proof.ctaHref}
    secondaryCta={p.proof.secondaryCta}
    secondaryHref={p.proof.secondaryHref}
  />

  {/* 5 — FAQ: packages'a özel liste, görünür + FAQPage şeması aynı veriden */}
  <section class="border-t border-line" aria-label={p.faq.title}>
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20" data-reveal-group>
      <div data-reveal>
        <FaqAccordion title={p.faq.title} items={p.faq.items} level="h2" />
      </div>
    </div>
  </section>

</BaseLayout>
