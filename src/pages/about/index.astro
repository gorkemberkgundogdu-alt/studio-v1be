---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { useTranslations } from "@/i18n";
import { aboutPageSchema, breadcrumbSchema } from "@/config/schemas";

const locale = "en" as const;
const path = "/about/";
const t = useTranslations(locale);
const a = t.about;

const crumbs = [
  { name: "Home", path: "/" },
  { name: t.nav.about, path },
];
---

<BaseLayout
  title={a.meta.title}
  description={a.meta.description}
  {locale}
  {path}
  schemas={[
    aboutPageSchema({ name: a.hero.title, description: a.meta.description, locale, path }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture border-b border-line">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-14 sm:px-6 md:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div data-reveal>
        <p class="font-mono text-sm font-bold uppercase tracking-widest text-accent">{a.hero.eyebrow}</p>
        <h1
          class="mt-4 font-extrabold"
          style="font-size: clamp(1.75rem, 1.2rem + 3.2vw, 3.5rem); line-height: 1.05; letter-spacing: -0.03em;"
        >
          {a.hero.title}
        </h1>
        {/* Canonical brand description — required verbatim in visible About copy. */}
        <p class="mt-6 max-w-3xl text-lg font-medium leading-relaxed text-ink sm:text-xl">{a.canonical}</p>
      </div>

      <div class="rounded-[2rem] border border-line bg-surface/60 p-5 sm:p-7" data-reveal style="--reveal-delay: 80ms" aria-label={a.hero.mapLabel}>
        <div class="rounded-2xl border border-line bg-base/80 p-5">
          <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-ink-muted">{a.hero.platform.label}</p>
          <p class="mt-2 text-2xl font-black text-ink">{a.hero.platform.name}</p>
          <p class="mt-2 text-sm font-medium leading-relaxed text-ink-muted">{a.hero.platform.role}</p>
        </div>

        <div class="flex items-center gap-3 py-3" aria-hidden="true">
          <span class="ml-6 size-2 rounded-full bg-accent"></span>
          <span class="h-px flex-1 bg-accent/50"></span>
          <span class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.14em] text-accent">shared method</span>
        </div>

        <div class="rounded-2xl border border-accent/45 bg-accent/10 p-5">
          <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-accent">{a.hero.studio.label}</p>
          <p class="mt-2 text-2xl font-black text-ink">{a.hero.studio.name}</p>
          <p class="mt-2 text-sm font-medium leading-relaxed text-ink-muted">{a.hero.studio.role}</p>
        </div>

        <div class="mt-3 rounded-2xl bg-accent p-5 text-(--color-base)">
          <p class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em]">{a.hero.outcome.label}</p>
          <p class="mt-2 text-lg font-black">{a.hero.outcome.value}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-light-base text-light-ink" aria-labelledby="about-relationship-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="max-w-3xl" data-reveal>
        <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-green">{a.relationship.eyebrow}</p>
        <h2 id="about-relationship-title" class="mt-3 text-h2 font-bold">{a.relationship.title}</h2>
        <p class="mt-5 font-medium leading-relaxed text-light-muted">{a.relationship.description}</p>
      </div>

      <div class="mt-10 grid gap-4 lg:grid-cols-2" data-reveal-group>
        {a.relationship.parts.map((part, index) => (
          <article class="rounded-[2rem] border border-light-line p-7 sm:p-8" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <div class="flex items-center justify-between gap-4">
              <span class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-green">{part.label}</span>
              <span class="font-mono text-xs font-bold text-light-muted">0{index + 1}</span>
            </div>
            <h3 class="mt-8 text-2xl font-black">{part.title}</h3>
            <p class="mt-4 font-medium leading-relaxed text-light-muted">{part.description}</p>
            <ul class="mt-6 space-y-3">
              {part.points.map((point) => (
                <li class="flex gap-3 text-sm font-semibold leading-relaxed">
                  <span class="text-green" aria-hidden="true">✓</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <p class="mt-4 rounded-2xl border border-light-line px-6 py-5 text-center font-mono text-xs font-bold uppercase tracking-[0.14em] text-green" data-reveal>
        {a.relationship.shared}
      </p>
    </div>
  </section>

  <section class="grid-texture border-b border-line" aria-labelledby="about-principles-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div data-reveal>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{a.principles.eyebrow}</p>
          <h2 id="about-principles-title" class="mt-3 text-h2 font-bold">{a.principles.title}</h2>
          <p class="mt-5 font-medium leading-relaxed text-ink-muted">{a.principles.description}</p>
        </div>

        <ol class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2" data-reveal-group>
          {a.principles.items.map((item, index) => (
            <li class="bg-base p-6 sm:p-7" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
              <span class="font-mono text-xs font-bold text-accent">0{index + 1}</span>
              <h3 class="mt-8 text-lg font-extrabold">{item.title}</h3>
              <p class="mt-3 text-sm font-medium leading-relaxed text-ink-muted">{item.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section aria-labelledby="about-proof-title">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <article class="overflow-hidden rounded-[2rem] bg-accent p-7 text-(--color-base) sm:p-10 md:p-12" data-reveal>
        <div class="flex flex-col gap-9 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="font-mono text-xs font-bold uppercase tracking-[0.18em]">{a.proof.eyebrow}</p>
            <h2 id="about-proof-title" class="mt-4 text-h2 font-black">{a.proof.title}</h2>
            <p class="mt-4 max-w-2xl font-semibold leading-relaxed opacity-75">{a.proof.description}</p>
          </div>
          <a
            href="/work/"
            class="cta-lift inline-flex h-12 w-fit shrink-0 items-center justify-center rounded-full bg-base px-7 text-base font-bold text-accent"
            style="color: var(--color-accent)"
          >
            {a.proof.cta} <span class="ml-2" aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="grid-texture border-t border-line" aria-labelledby="about-cta-title">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 md:py-24" data-reveal>
      <p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-accent">{a.cta.eyebrow}</p>
      <h2 id="about-cta-title" class="mt-3 text-h2 font-bold">{a.cta.title}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg font-medium leading-relaxed text-ink-muted">{a.cta.subtitle}</p>
      <div class="mt-8 flex justify-center">
        <Button href="/contact/">{a.cta.button}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
