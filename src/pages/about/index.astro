---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { useTranslations } from "@/i18n";
import { aboutPageSchema, breadcrumbSchema } from "@/config/schemas";

const locale = "en" as const;
const path = "/about/";
const t = useTranslations(locale);
const a = t.about;

const crumbs = [
  { name: "Home", path: "/" },
  { name: t.nav.about, path },
];
---

<BaseLayout
  title={a.meta.title}
  description={a.meta.description}
  {locale}
  {path}
  schemas={[
    aboutPageSchema({ name: a.hero.title, description: a.meta.description, locale, path }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">{a.hero.eyebrow}</p>
      <h1 class="mt-4 text-display font-extrabold">{a.hero.title}</h1>
      {/* Kanonik marka tarifi — birebir (CLAUDE.md §1) */}
      <p class="mt-6 text-xl leading-relaxed text-ink">{a.canonical}</p>
    </div>
  </section>

  <section class="border-t border-line" aria-label={a.hero.title}>
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <div class="space-y-12" data-reveal-group>
        {a.body.map((block, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <h2 class="text-xl font-bold text-ink">{block.heading}</h2>
            <p class="mt-3 leading-relaxed text-ink-muted">{block.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="grid-texture border-t border-line">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 md:py-20">
      <h2 class="text-h2 font-bold">{a.cta.title}</h2>
      <p class="mt-4 text-lg text-ink-muted">{a.cta.subtitle}</p>
      <div class="mt-8 flex justify-center">
        <Button href="/contact/">{a.cta.button}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
