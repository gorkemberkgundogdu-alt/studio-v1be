---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import AuditForm from "@/components/AuditForm.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import { useTranslations } from "@/i18n";
import { splitAccent } from "@/lib/text-highlight";
import { faqSchema, breadcrumbSchema, webPageSchema } from "@/config/schemas";

const locale = (Astro.props.locale ?? "en") as import("@/i18n").Locale;
const path = "/contact/";
const t = useTranslations(locale);
const c = t.contact;

const crumbs = [
  { name: t.footer.nav.home, path: "/" },
  { name: c.breadcrumbLabel, path },
];
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  {locale}
  {path}
  schemas={[
    webPageSchema({ name: c.hero.title, description: c.meta.description, locale, path }),
    faqSchema(c.faq.items, locale),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <h1 class="text-display font-extrabold">
        {splitAccent(c.hero.title, "v1be").map((seg) =>
          seg.accent ? <span class="text-accent">{seg.text}</span> : seg.text
        )}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-muted">{c.hero.promise}</p>

      <div class="mt-10">
        <AuditForm {locale} />
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-label={c.faq.title}>
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <FaqAccordion title={c.faq.title} items={c.faq.items} level="h2" />
    </div>
  </section>
</BaseLayout>
