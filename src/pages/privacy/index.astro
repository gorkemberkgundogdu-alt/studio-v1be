---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { webPageSchema, breadcrumbSchema } from "@/config/schemas";

const locale = "en" as const;
const path = "/privacy/";

const title = "Privacy Policy";
const description = "How v1be studio collects, uses and protects information submitted through this site.";

const crumbs = [
  { name: "Home", path: "/" },
  { name: title, path },
];

const sections = [
  {
    heading: "What we collect",
    body: [
      "When you submit the contact form, we collect your name, email address, website URL, and message. We use this only to respond to your audit request or inquiry — nothing else.",
      "When you browse the site, we use cookies and similar technology to understand how the site is used. This only happens after you accept cookies in the banner shown on your first visit. If you decline, none of the tools below run.",
    ],
  },
  {
    heading: "Tools we use",
    body: [
      "Google Analytics and Google Tag Manager — to see which pages get visited and how",
      "Meta Pixel and LinkedIn Insight Tag — to measure whether our ads are reaching the right people",
      "Microsoft Clarity — to see anonymized session recordings and identify confusing parts of the site",
    ],
    listIntro: null,
    listOutro:
      "Each of these is controlled through Google Tag Manager and gated by your cookie choice. None of them load before you accept.",
    isList: true,
  },
  {
    heading: "What we don't do",
    body: [
      "We don't sell your data. We don't share your contact form submissions with anyone outside v1be. We don't use your information for anything beyond responding to you and understanding site usage in aggregate.",
    ],
  },
  {
    heading: "Your rights",
    body: [
      "You can ask us what data we hold about you, ask us to correct it, or ask us to delete it. Email hello@v1be.io and we'll handle it within a reasonable time.",
    ],
  },
  {
    heading: "Changes",
    body: [
      "If this policy changes, we'll update the date at the top. We won't email you about minor wording changes.",
    ],
  },
];
---

<BaseLayout
  title={`${title} | v1be studio`}
  {description}
  {locale}
  {path}
  schemas={[
    webPageSchema({ name: title, description, locale, path }),
    breadcrumbSchema(crumbs, locale),
  ]}
>
  <Breadcrumb {locale} items={crumbs} />

  <section class="grid-texture">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">Last updated: July 2026</p>
      <h1 class="mt-4 text-display font-extrabold">{title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">
        v1be studio ("we," "us") operates studio.v1be.io. This page describes what we collect
        when you use this site and why.
      </p>
    </div>
  </section>

  <section class="border-t border-line" aria-label={title}>
    <div class="mx-auto max-w-3xl space-y-12 px-4 py-16 sm:px-6 md:py-20" data-reveal-group>
      {sections.map((s, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <h2 class="text-2xl font-bold text-ink">{s.heading}</h2>
          {s.isList ? (
            <>
              <ul class="mt-4 space-y-2">
                {s.body.map((item) => (
                  <li class="flex gap-3 leading-relaxed text-ink-muted">
                    <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              {s.listOutro && <p class="mt-4 leading-relaxed text-ink-muted">{s.listOutro}</p>}
            </>
          ) : (
            s.body.map((p) => <p class="mt-4 leading-relaxed text-ink-muted">{p}</p>)
          )}
        </div>
      ))}

      <div data-reveal style={`--reveal-delay: ${sections.length * 80}ms`}>
        <h2 class="text-2xl font-bold text-ink">Contact</h2>
        <p class="mt-4 leading-relaxed text-ink-muted">
          <a
            href="mailto:hello@v1be.io"
            class="font-medium text-ink underline decoration-line underline-offset-4 hover:decoration-accent"
          >
            hello@v1be.io
          </a>
        </p>
        {/* TODO: legal review — company legal name, registration number and registered address pending founder input (CLAUDE.md §9) */}
        <p class="mt-4 leading-relaxed text-ink-muted">
          [Company legal name, registration number, and registered address — to be added]
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
