---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import RobotMascot from "@/components/sections/RobotMascot.astro";
import AuditForm from "@/components/AuditForm.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import { useTranslations } from "@/i18n";
import { faqSchema } from "@/config/schemas";
import { splitAccent, highlightWords } from "@/lib/text-highlight";

const locale = "en" as const;
const path = "/";
const t = useTranslations(locale);
const h = t.home;
---

<BaseLayout
  title={h.meta.title}
  description={h.meta.description}
  {locale}
  {path}
  schemas={[faqSchema(t.contact.faq.items)]}
  paginateFooter
>
  {/*
    S1 — Hero (dark). Only the headline + mascot — nothing else — fills the
    viewport below the sticky header (min-h calc(100svh-4rem)) so nothing
    from S2 peeks in on load. Content is vertically centered (justify-center)
    as a single block, which is what makes the gap above (navbar→headline)
    and the gap below (mascot's feet→page end) come out equal automatically
    — matching top/bottom padding values alone can't guarantee that once a
    flex column isn't centered, leftover space just pools at the bottom.
    Mascot sits just under the last line ("for AI."), pulled up slightly so
    its antenna still overlaps the text above (intentional, reads as natural
    since it's animated) — that overlap amount is purely margin-driven, so
    scaling the mascot's own size doesn't change it.
  */}
  <section
    class="grid-texture relative flex min-h-[calc(100svh-4rem)] flex-col overflow-hidden"
    data-paginate
  >
    <div class="mx-auto flex w-full max-w-[96rem] flex-1 flex-col justify-center px-4 py-6 sm:px-6">
      {/*
        4 lines instead of 2: with 2 lines, both ended in a lime-accent word
        ("Awwwards."/"AI."), and centered, the two lime words landed almost
        stacked on top of each other — read as an awkward vertical color
        stripe. 4 separate lines breaks that up.
      */}
      {/*
        Mobile: lines are `inline` (not `block`), with a real space between
        them, so the browser's own greedy line-wrap can pull the next line's
        first word up onto the previous line's leftover space — e.g. "enough"
        (orphaned off "Beautiful") and "for" (orphaned off "Awwwards.") land
        on the same line instead of each getting its own. At sm+ (640px),
        lines switch back to `block`, restoring the guaranteed 4-line
        desktop structure exactly as before.
      */}
      <h1 class="font-black leading-[0.98] text-center" style="font-size: clamp(2.75rem, 6vw, 5.25rem)">
        {h.hero.headline.map((line) => (
          <>
            <span class="inline sm:block">
              {splitAccent(line.text, line.accent).map((seg) =>
                seg.accent ? <span class="text-accent">{seg.text}</span> : seg.text,
              )}
            </span>{" "}
          </>
        ))}
      </h1>

      {/*
        Mascot — 180px/270px, sized to leave clear room below for the
        scroll-down pill without clipping against Hero's overflow-hidden
        bottom edge at short viewport heights (768–800px). No `name` prop
        here — RobotMascot.astro stays byte-identical to the main site
        (nameplate mechanism is a plain-text span, no room for an icon), so
        the scroll-down hint below is its own independent element instead.
      */}
      <div class="-mt-2 mx-auto w-[180px] shrink-0 md:-mt-4 xl:w-[270px]">
        <RobotMascot look="classic" />
      </div>

      {/* Scroll-down hint — same pill language as the mascot's own nameplate
          (font-mono, muted ink, blurred surface pill) but a separate
          element so it can carry an icon + text together. mt-8 gives it
          clear breathing room below the mascot (confirmed there's still
          slack at the bottom of Hero at short viewport heights). */}
      <div
        class="mx-auto mt-8 flex items-center gap-2 rounded-full border border-line bg-surface/72 px-[0.7rem] py-[0.2rem] font-mono text-[0.78rem] font-semibold tracking-[0.08em] text-ink-muted backdrop-blur-md"
        aria-hidden="true"
      >
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="shrink-0">
          <path
            d="M5 1.2V7M1.8 4.5L5 7.5L8.2 4.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span>Scroll down</span>
      </div>
    </div>
  </section>

  {/*
    S2–S6: every section is full-viewport height (min-h 100svh), content
    vertically centered (flex flex-col justify-center), and — same as the
    Hero — part of the paginated wheel zone (see [data-paginate] in
    global.css and lib/paginate.ts). All 6 Home sections are one continuous
    wheel-controlled sequence now; there's no mid-page handoff to native
    scroll to glitch at (that boundary used to sit between Work and FAQ and
    was the source of a stuck/broken transition — removed by extending the
    zone through Contact instead). The zone releases only once, at the very
    end (Contact → Footer). Desktop/fine-pointer/motion-ok only (gated in
    both CSS and JS); on mobile, touch, narrow viewports, or reduced-motion
    it's fully inert — all 6 sections render as normal static stacked
    blocks, plain native scroll throughout, straight into the Footer.
  */}
  {/* S2 — What we do (dark): simplified to a heading + CTA, no cards */}
  <section
    class="grid-texture flex min-h-[100svh] flex-col justify-center border-t border-line"
    data-paginate
    aria-label="What we do"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28" data-reveal-group>
      <h2
        class="text-[clamp(2rem,1.5rem+1.39vw,2.5rem)] leading-[1.2] tracking-[-0.025em]"
        data-reveal
      >
        {h.what.headingLines.map((line, i) => (
          <span
            class:list={[
              "block",
              i === 0 && "ml-8",
              i === 2 && "text-center",
            ]}
          >
            {highlightWords(line, h.what.bold).map((seg) =>
              seg.bold ? <strong class="font-black">{seg.text}</strong> : seg.text,
            )}
          </span>
        ))}
      </h2>
      <div class="mt-12 flex justify-center" data-reveal style="--reveal-delay: 80ms">
        <Button href="/contact/" size="sm">{h.what.cta}</Button>
      </div>

      {/* Keep-scrolling hint — same pill language as Hero's "Scroll down"
          (font-mono, muted ink, blurred surface pill, down chevron).
          inline-flex (not flex) so the pill shrinks to its content instead
          of stretching full-width as a flex item of the reveal-group. */}
      <div class="mt-16 flex justify-center sm:mt-36" data-reveal style="--reveal-delay: 160ms">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/72 px-[0.7rem] py-[0.2rem] font-mono text-[0.78rem] font-semibold tracking-[0.08em] text-ink-muted backdrop-blur-md"
          aria-hidden="true"
        >
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="shrink-0">
            <path
              d="M5 1.2V7M1.8 4.5L5 7.5L8.2 4.5"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>Keep scrolling</span>
        </div>
      </div>
    </div>
  </section>

  {/* S3 — How we do it (light/white, rounded top) */}
  <section
    class="flex min-h-[100svh] flex-col justify-center rounded-t-[2.5rem] bg-light-base text-light-ink"
    data-paginate
    aria-labelledby="how-title"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <h2 id="how-title" class="text-h2 font-bold text-light-ink" data-reveal>{h.how.title}</h2>
      <ol class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2" data-reveal-group>
        {h.how.steps.map((step, i) => (
          <li class="flex gap-5" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <span class="font-mono text-2xl font-bold text-purple" aria-hidden="true">{step.number}</span>
            <div>
              <h3 class="text-lg font-semibold text-light-ink">{step.title}</h3>
              <p class="mt-2 text-base font-medium leading-relaxed text-light-muted">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-12 flex flex-wrap items-center gap-4" data-reveal>
        <Button href="/contact/">{h.how.cta}</Button>
        <a
          href="/process/"
          class="cta-lift inline-flex items-center justify-center rounded-full bg-surface px-6 py-3 font-medium text-accent transition-opacity duration-150 hover:opacity-90"
        >
          {h.how.ctaSecondary}
        </a>
      </div>
    </div>
  </section>

  {/* S4 — Work (dark) */}
  <section
    class="grid-texture flex min-h-[100svh] flex-col justify-center border-t border-line"
    data-paginate
    aria-labelledby="work-title"
  >
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <h2 id="work-title" class="text-h2 font-bold" data-reveal>{h.work.title}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2" data-reveal-group>
        <article
          class="flex flex-col rounded-2xl border border-line bg-surface p-8"
          data-reveal
        >
          <h3 class="text-2xl font-bold text-ink">{h.work.caseCard.name}</h3>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-muted">{h.work.caseCard.description}</p>
          <a
            href={h.work.caseCard.href}
            class="mt-6 inline-flex items-center gap-1 font-semibold text-accent underline decoration-transparent underline-offset-4 transition hover:decoration-accent"
          >
            {h.work.caseCard.linkLabel} →
          </a>
        </article>

        <article
          class="flex flex-col justify-between rounded-2xl border border-dashed border-line p-8"
          data-reveal
          style="--reveal-delay: 80ms"
        >
          <p class="text-lg font-medium leading-relaxed text-ink-muted">{h.work.openSlot.label}</p>
          <div class="mt-6">
            <Button href="/contact/" variant="ghost">{h.work.openSlot.cta}</Button>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* S5 — FAQ (dark), its own section between Work and the audit CTA */}
  <section
    class="grid-texture min-h-[100svh] overflow-y-auto overscroll-contain border-t border-line"
    data-paginate
    data-paginate-scroll
    aria-label={t.contact.faq.title}
  >
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20" data-reveal-group>
      <div data-reveal>
        <FaqAccordion title={t.contact.faq.title} items={t.contact.faq.items} level="h2" />
      </div>
    </div>
  </section>

  {/* S6 — Get your v1be (dark) */}
  <section
    class="grid-texture flex min-h-[100svh] flex-col justify-center border-t border-line"
    data-paginate
    aria-labelledby="contact-title"
  >
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-28">
      <h2 id="contact-title" class="text-h2 font-bold" data-reveal>{h.contact.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted" data-reveal style="--reveal-delay: 60ms">
        {h.contact.promise}
      </p>

      <div class="mt-10" data-reveal style="--reveal-delay: 120ms">
        <AuditForm {locale} />
      </div>
    </div>
  </section>

  {/*
    Spacer for the paginated zone — 7 blocks now: Home's 6 sections (Hero →
    Contact) PLUS the Footer, which BaseLayout renders with paginate={true}
    (see Footer.astro's `data-paginate` on this page) making it the chain's
    final member instead of a native-scroll handoff target. All 7 are
    position: fixed while the zone is active, so none occupy document flow;
    without these spacers the page would have no scroll height to reach the
    last one at all. One min-h-[100svh] block per paginated section (order
    doesn't need to match visually — they only reserve total scroll
    distance so `scrollY` stays in sync with `current`). Collapses to 0
    height outside the qualifying media query (mobile/touch/reduced-motion)
    via .paginate-spacer in global.css — in that case all 7 sections
    (including Footer) are plain static blocks using their own natural
    height, normal page flow straight through.
  */}
  <div aria-hidden="true">
    <div class="paginate-spacer"></div>
    <div class="paginate-spacer"></div>
    <div class="paginate-spacer"></div>
    <div class="paginate-spacer"></div>
    <div class="paginate-spacer"></div>
    <div class="paginate-spacer"></div>
    <div class="paginate-spacer"></div>
  </div>
</BaseLayout>
