---
/**
 * Tüm sayfaların iskeleti (CLAUDE.md §2). Head yönetimi Seo.astro'ya delege edilir.
 * Organization + WebSite JSON-LD her sayfaya otomatik enjekte edilir; sayfaya
 * özel şemalar `schemas` prop'uyla @graph'e eklenir.
 * Font: Montserrat Variable, self-hosted (fontsource) + preload (LCP koruması).
 */
import "@/styles/global.css";
import montserratWoff2 from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import "@fontsource-variable/montserrat/index.css";

import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

import Seo from "@/components/seo/Seo.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import ConsentBanner from "@/components/analytics/ConsentBanner.astro";
import { SITE } from "@/config/site";
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Locale prefix'siz path, örn "/" veya "/packages/". */
  path: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Sayfaya özel JSON-LD objeleri; Organization + WebSite otomatik eklenir. */
  schemas?: Record<string, unknown>[];
  /** Home'da true: Footer paginate zincirinin son üyesi olur (bkz Footer.astro). */
  paginateFooter?: boolean;
}

const {
  title,
  description,
  locale,
  path,
  ogImage,
  ogType,
  noindex,
  schemas = [],
  paginateFooter = false,
} = Astro.props;
const t = useTranslations(locale);

// Logo yalnızca dosya gerçekten varsa şemaya girer (CLAUDE.md §3, opsiyonel alan).
const logoPath = fileURLToPath(new URL("../../public/logo.png", import.meta.url));
const hasLogo = existsSync(logoPath);

const sameAs = Object.values(SITE.social).filter(Boolean);
const baseSchemas: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": `${SITE.url}/#organization`,
    name: SITE.name,
    legalName: SITE.legalName,
    url: SITE.url,
    email: SITE.email,
    foundingDate: String(SITE.foundingYear),
    description: SITE.description,
    parentOrganization: { "@id": SITE.parentOrg.id },
    ...(hasLogo ? { logo: `${SITE.url}/logo.png` } : {}),
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
  {
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    name: `${SITE.name} — ${SITE.tagline}`,
    url: SITE.url,
    publisher: { "@id": `${SITE.url}/#organization` },
    inLanguage: locale,
  },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <!-- Consent Mode v2 defaults, MUST run before GTM loads.
         Returning visitors who already accepted get a GRANTED default read
         synchronously from localStorage — otherwise their first page_view of
         every visit fires while consent is still "denied" (hydration runs long
         after GTM) and Meta/LinkedIn base pixels stay blocked until the next
         navigation. Key must match CONSENT_KEY in src/lib/analytics.ts. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      (function () {
        var granted = false;
        try {
          granted = localStorage.getItem("v1be_studio_consent_v1") === "granted";
        } catch (e) {
          /* storage blocked → stay denied */
        }
        var choice = granted ? "granted" : "denied";
        gtag("consent", "default", {
          ad_storage: choice,
          ad_user_data: choice,
          ad_personalization: choice,
          analytics_storage: choice,
          functionality_storage: "granted",
          security_storage: "granted",
          wait_for_update: 500,
        });
      })();
    </script>
    <!-- End Consent Mode v2 defaults -->
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-P4W692GG");
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href={montserratWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Seo {title} {description} {locale} {path} {ogImage} {ogType} {noindex} />
    <JsonLd schema={[...baseSchemas, ...schemas]} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* SEO-safe animasyon bootstrap: JS varsa .js-anim ekler; yoksa her şey görünür (CLAUDE.md §11) */}
    <script is:inline>
      document.documentElement.classList.add("js-anim");
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P4W692GG"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-(--color-base)"
    >
      {t.a11y.skipToContent}
    </a>
    <Header {locale} {path} />
    <main id="main">
      <slot />
    </main>
    <Footer {locale} paginate={paginateFooter} />
    <ConsentBanner />
    <script>
      import { initScrollFx } from "@/lib/scroll-fx";
      import { initPaginate } from "@/lib/paginate";
      import { initAnalytics } from "@/lib/analytics";
      initScrollFx();
      initPaginate();
      initAnalytics();
    </script>
  </body>
</html>
