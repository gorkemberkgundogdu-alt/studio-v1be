# v1be studio — Apache/cPanel config. public/ içinde durur, her build'de dist'e kopyalanır.

RewriteEngine On

# HTTPS zorla + www -> non-www (canonical host tek: https://studio.v1be.io)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://studio.v1be.io%{REQUEST_URI} [L,R=301]

# Sıkıştırma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache: hash'li asset'ler immutable, HTML/XML/TXT her zaman revalidate
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Güvenlik başlıkları
  # Entegrasyon envanteri: GTM/GA, Meta, LinkedIn, Clarity ve Supabase audit endpoint'i.
  # Yeni bir GTM vendor'i eklenirse bu allowlist ve deploy smoke check birlikte güncellenir.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' mailto:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://snap.licdn.com https://www.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com https://www.facebook.com https://px.ads.linkedin.com https://*.clarity.ms https://c.bing.com; font-src 'self'; connect-src 'self' https://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com https://*.facebook.com https://px.ads.linkedin.com https://*.linkedin.com https://*.clarity.ms https://c.bing.com; frame-src https://www.googletagmanager.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Doğru MIME (bazı cPanel kurulumlarında eksik olabiliyor)
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddCharset UTF-8 .txt
</IfModule>

ErrorDocument 404 /404.html
