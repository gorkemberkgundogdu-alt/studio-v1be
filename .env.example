# Audit form submission uses the Supabase Edge Function in
# supabase/functions/audit-request-submit. Both values are intentionally
# public browser credentials; database access remains protected by RLS and
# all writes happen inside the Edge Function with the server-side service role.
# If either value is blank, the form falls back to mailto:hello@v1be.io.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
