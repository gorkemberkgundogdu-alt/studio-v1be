# Contact form submission endpoint (Formspree-style POST URL).
# Read at build time as import.meta.env.PUBLIC_FORM_ENDPOINT.
# If left blank, the contact form degrades gracefully to a mailto: link
# (no third-party dependency, works on static/Apache hosting).
#
# Example (Formspree): https://formspree.io/f/your-form-id
PUBLIC_FORM_ENDPOINT=
